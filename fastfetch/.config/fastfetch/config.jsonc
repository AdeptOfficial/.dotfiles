{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/adept/.config/fastfetch/assets/logo.txt",
    "width": 5,
    "padding": {
      "top": 2,
      "right": 3,
      "left": 1
    }
  },  
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#00ff88"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "#00ff88"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "#00ff88"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "#00ff88"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "#00ff88",
      "folders": ["/", "/mnt/SharedData", "/mnt/SynaDrive"],
      "format": "{name} | {size-used}/{size-total} {size-percentage-bar} ({size-percentage}%)"      
    },
    {
      "type": "memory",
      "key": "└ └",
      "keyColor": "#00ff88"
    },
    //{
      //"type": "swap",
      //"key": "└ └󰓡 ",
      //"keyColor": "#00ff88"
    //},
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "#00ff88",
      "text": "version=$(adept-version); echo \"AdeptOS\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#00ff88"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#00ff88"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "#00ff88"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#00ff88"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#00ff88"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#00ff88"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "#00ff88",
      "text": "theme=$(cat ~/.config/themes/current.name 2>/dev/null | sed 's/./\\u&/' || echo 'Unknown'); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "#00ff88"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "#ff79c6",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "#ff79c6"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "#ff79c6",
      "text": "updated=$(adept-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
