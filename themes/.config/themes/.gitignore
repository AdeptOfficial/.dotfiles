
# Theme switch runtime state; templates and palettes remain versioned.
.switch.lock
.syna-stage-*/
.current.name.tmp
previous/
# The active theme is per machine (syna-theme-set regenerates it; install.sh sets one after stowing)
current/
current.name

# Trash from the theme/wallpaper remover; not versioned
.removed-themes/
.removed-wallpapers/
