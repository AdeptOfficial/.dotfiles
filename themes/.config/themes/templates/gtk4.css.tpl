/* Generated by the Syna theme engine from the active theme's palette; linked as ~/.config/gtk-4.0/gtk.css
   by syna-theme-set-gnome. libadwaita (GTK4 apps) reads these named accent colours. */
@define-color accent_bg_color {{ accent }};
@define-color accent_fg_color {{ selection_foreground }};
@define-color accent_color {{ accent }};
