// Generated from the selected Syna palette.
$theme-background: {{ background }};
$theme-foreground: {{ foreground }};
$theme-accent: {{ accent }};
$theme-success: {{ color2 }};
$theme-warning: {{ color3 }};
$theme-error: {{ color1 }};
$theme-secondary: {{ color5 }};
$theme-muted: mix($theme-foreground, $theme-background, 50%);
$theme-surface: mix($theme-foreground, $theme-background, 5%);
$theme-surface-raised: mix($theme-foreground, $theme-background, 10%);
