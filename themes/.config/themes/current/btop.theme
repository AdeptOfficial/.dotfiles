# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a1014"

# Main text color
theme[main_fg]="#eff8fa"

# Title color for boxes
theme[title]="#eff8fa"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#3fd4e6"

# Background color of selected item in processes box
theme[selected_bg]="#7e95a0"

# Foreground color of selected item in processes box
theme[selected_fg]="#3fd4e6"

# Color of inactive/disabled text
theme[inactive_fg]="#7e95a0"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#eff8fa"

# Background color of the percentage meters
theme[meter_bg]="#7e95a0"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#eff8fa"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#e359c9"
theme[mem_box]="#3fe0a8"
theme[net_box]="#f0597f"
theme[proc_box]="#3fd4e6"

# Box divider line and small boxes line color
theme[div_line]="#7e95a0"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#3fe0a8"
theme[temp_mid]="#dfa35c"
theme[temp_end]="#f0597f"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#3fd4e6"
theme[cpu_mid]="#6a8fd1"
theme[cpu_end]="#e359c9"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#e359c9"
theme[free_mid]="#6a8fd1"
theme[free_end]="#3fd4e6"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#6a8fd1"
theme[cached_mid]="#3fd4e6"
theme[cached_end]="#e359c9"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#dfa35c"
theme[available_mid]="#f0597f"
theme[available_end]="#f0597f"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#3fe0a8"
theme[used_mid]="#3fd4e6"
theme[used_end]="#6a8fd1"

# Download graph colors (Peach -> Red)
theme[download_start]="#dfa35c"
theme[download_mid]="#f0597f"
theme[download_end]="#f0597f"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#3fe0a8"
theme[upload_mid]="#3fd4e6"
theme[upload_end]="#6a8fd1"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#3fd4e6"
theme[process_mid]="#6a8fd1"
theme[process_end]="#e359c9"
