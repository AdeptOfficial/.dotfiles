-- Default monitor configuration
-- See https://wiki.hyprland.org/Configuring/Monitors/
-- List current monitors: hyprctl monitors
-- Format: monitor = [port], resolution, position, scale

-- Auto-detect all monitors at preferred resolution
-- Generated by hyprlang2lua. Review TODOs before reloading Hyprland.

hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "1",
})

-- Environment for GTK scaling
hl.env("GDK_SCALE", "1")

-- Basic workspaces (no monitor binding - works on any setup)
-- Customize per-machine by editing ~/.config/hypr/monitors.conf
