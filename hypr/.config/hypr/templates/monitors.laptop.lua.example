-- ASUS ROG Zephyrus G14 2022 (GA402RJ) Monitor Configuration
-- 14" 2560x1600 (QHD+ 16:10) @ 120Hz
--
-- To use: Replace monitors.conf with this file or source it
-- cp monitors.laptop.conf monitors.conf
-- OR: source = ~/.config/hypr/monitors.laptop.conf

-- G14 built-in display (eDP-1)
-- 1.25 scale recommended for 14" QHD+ (readable without squinting)
-- Generated by hyprlang2lua. Review TODOs before reloading Hyprland.

hl.monitor({
    output = "eDP-1",
    mode = "2560x1600@120",
    position = "0x0",
    scale = "1.25",
})

-- GTK scaling (use 1 since Hyprland handles fractional)
hl.env("GDK_SCALE", "1")

-- External monitor support (uncomment when docked)
-- monitor = DP-1, preferred, auto-right, 1
-- monitor = HDMI-A-1, preferred, auto-right, 1

-- XWayland scaling (AMD compatible)

hl.workspace_rule({
    workspace = "1",
    monitor = "eDP-1",
    default = true,
})

hl.workspace_rule({
    workspace = "2",
    monitor = "eDP-1",
})

hl.workspace_rule({
    workspace = "3",
    monitor = "eDP-1",
})

hl.workspace_rule({
    workspace = "4",
    monitor = "eDP-1",
})

hl.workspace_rule({
    workspace = "5",
    monitor = "eDP-1",
})

hl.config({
    xwayland = {
        force_zero_scaling = true,
    },
    -- Workspaces - all on built-in display
    -- When external monitor connected, can reassign workspaces
    -- workspace = 2, monitor:DP-1, default:true
})

