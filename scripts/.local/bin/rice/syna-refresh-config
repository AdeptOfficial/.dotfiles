#!/bin/bash

# Copies the named config from ~/.config/rice/config/X/Y/Z -> ~/.config/X/Y/Z.
# If the config already exists, a backup of the existing will be taken as .bak.TIMESTAMP.

set -euo pipefail
config_file=${1:-}

if [[ -z "$config_file" ]]; then
  cat <<USAGE
  Usage: $0 [config_file]

  Must provide a file path from the .config directory to be refreshed.
  To copy ~/.config/rice/config/hypr/hyprlock.conf to ~/.config/hypr/hyprlock.conf

    $0 hypr/hyprlock.conf
USAGE
  exit 1
fi

[[ $config_file != /* && /$config_file/ != */../* && /$config_file/ != */./* && $config_file != *$'\n'* ]] || { echo 'Config path must stay inside ~/.config' >&2; exit 2; }

# Backup the destination file (with timestamp) to avoid clobbering (Ex: hyprlock.conf.bak.1753817951)
user_config_file="${HOME}/.config/$config_file"
default_config_file="${HOME}/.config/rice/defaults/$config_file"
[[ -f $default_config_file ]] || { echo "Default missing: $default_config_file; nothing changed" >&2; exit 1; }
mkdir -p -- "$(dirname -- "$user_config_file")"

if [[ -f "$user_config_file" ]]; then
  # Create preliminary backup
  backup_config_file=$(mktemp "$user_config_file.bak.XXXXXXXX")
  cp -p -- "$user_config_file" "$backup_config_file"

  # Replace config with new default
  cp -- "$default_config_file" "$user_config_file"

  # Compare and delete/inform accordingly
  if cmp -s "$user_config_file" "$backup_config_file"; then
    echo "Already matches defaults; backup retained: $backup_config_file"
  else
    echo -e "\e[31mReplaced $user_config_file with rice default.\nSaved backup as ${backup_config_file}.\n\n\e[32mChanges:\e[0m"
    diff "$user_config_file" "$backup_config_file" || true
  fi
else
  # Config file did not exist already
  cp -- "$default_config_file" "$user_config_file"
fi
