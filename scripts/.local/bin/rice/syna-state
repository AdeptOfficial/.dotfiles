#!/bin/bash

# Sets (touch) or clears (deletes matching) flag files in ~/.local/state/rice

STATE_DIR="$HOME/.local/state/rice"
mkdir -p "$STATE_DIR"

COMMAND="$1"
STATE_NAME="$2"
[[ $STATE_NAME != */* && $STATE_NAME != . && $STATE_NAME != .. ]] || { echo 'Invalid state name' >&2; exit 2; }

if [[ -z "$COMMAND" ]]; then
  echo "Usage: syna-state <set|clear> <state-name-or-pattern>"
  exit 1
fi

if [[ -z "$STATE_NAME" ]]; then
  echo "Usage: syna-state $COMMAND <state-name>"
  exit 1
fi

case "$COMMAND" in
set) touch "$STATE_DIR/$STATE_NAME" ;;
clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
*) echo 'Usage: syna-state <set|clear> <state-name-or-pattern>' >&2; exit 2 ;;
esac
