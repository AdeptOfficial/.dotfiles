#!/bin/bash

# Build a per-user Papirus variant with coloured folders, e.g. Papirus-Dark-Cyan, without touching /usr/share
# (papirus-folders recolours the system theme globally; this keeps one colour per Syna theme). The variant
# inherits Papirus-Dark and only remaps folder icons to the chosen colour; pick it in the theme picker's Icons tab.
#   syna-icons-papirus <colour> [Papirus|Papirus-Dark|Papirus-Light]   e.g. syna-icons-papirus cyan
#   syna-icons-papirus --list                                           colours this Papirus ships

set -euo pipefail
base=${2:-Papirus-Dark}
case $base in Papirus|Papirus-Dark|Papirus-Light) ;; *) echo 'Invalid Papirus base theme' >&2; exit 2 ;; esac
src=/usr/share/icons/Papirus     # folder icons live here; -Dark/-Light inherit them
[[ -d $src ]] || { echo "Papirus is not installed: sudo pacman -S --needed papirus-icon-theme" >&2; exit 1; }

# A colour is a name with a full set of variants, e.g. folder-cyan.svg and folder-cyan-download.svg
colours() { find "$src" -path '*/places/folder-*-download.svg' -printf '%f\n' | sed -n 's/^folder-\([a-z]*\)-download\.svg$/\1/p' | sort -u; }
if [[ ${1:-} == --list || -z ${1:-} ]]; then colours | tr '\n' ' '; echo; exit 0; fi
colour=$1
colours | grep -Fx -- "$colour" >/dev/null || { echo "Unknown colour '$colour'. Available: $(colours | tr '\n' ' ')" >&2; exit 2; }

name="$base-${colour^}"
out=~/.local/share/icons/$name
if [[ -e $out || -L $out ]]; then
  archive=$(mktemp -d "$HOME/.local/share/icons/.papirus-backup.XXXXXXXX")
  mv -- "$out" "$archive/theme"
  echo "Previous icon theme retained: $archive/theme"
fi
mkdir -p "$out"
cat > "$out/index.theme" <<EOF
[Icon Theme]
Name=$name
Comment=$base with $colour folders (generated by syna-icons-papirus)
Inherits=$base,hicolor
EOF

# Each size's places/folder-<colour>-<kind>.svg becomes places/folder-<kind>.svg (and user-* / default names)
dirs=()
while IFS= read -r -d '' file; do
  rel=${file#"$src"/}; dir=${rel%/*}; f=${file##*/}
  target=${f/folder-$colour/folder}
  [[ $target == "$f" ]] && continue
  mkdir -p "$out/$dir"; ln -sf "$file" "$out/$dir/$target"
  [[ $target == folder.svg ]] && ln -sf "$file" "$out/$dir/inode-directory.svg"
  dirs+=("$dir")
done < <(find "$src" -path '*/places/folder-'"$colour"'*.svg' -print0)
# user-home, user-desktop … use the coloured folder variants too
while IFS= read -r -d '' file; do
  rel=${file#"$src"/}; dir=${rel%/*}; f=${file##*/}
  ln -sf "$file" "$out/$dir/${f/user-$colour/user}"
done < <(find "$src" -path '*/places/user-'"$colour"'*.svg' -print0)

printf 'Directories=%s\n' "$(printf '%s\n' "${dirs[@]}" | sort -u | paste -sd,)" >> "$out/index.theme"
for d in $(printf '%s\n' "${dirs[@]}" | sort -u); do
  size=${d%%x*}; size=${size%%@*}
  [[ $size =~ ^[0-9]+$ ]] || size=48
  printf '\n[%s]\nContext=Places\nSize=%s\nType=Fixed\n' "$d" "$size" >> "$out/index.theme"
done
gtk-update-icon-cache -q -f -t "$out" 2>/dev/null || true
echo "Built $out ($(find "$out" -name '*.svg' | wc -l) folder icons). Choose '$name' in the theme picker's Icons tab."
