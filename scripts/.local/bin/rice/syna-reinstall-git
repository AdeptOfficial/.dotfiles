#!/bin/bash
# Reset dotfiles from git (discard local changes)

set -e

if [[ ! -d "$HOME/.dotfiles/.git" ]]; then
  echo "No git repo at ~/.dotfiles"
  exit 1
fi

echo "This will discard all local changes to ~/.dotfiles"
read -p "Continue? [y/N]: " confirm

if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
  echo "Aborted"
  exit 1
fi

cd ~/.dotfiles
git fetch origin
git reset --hard origin/$(git rev-parse --abbrev-ref HEAD)

echo "Dotfiles reset to remote state"
echo "You may need to re-stow packages"
