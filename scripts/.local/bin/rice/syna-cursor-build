#!/usr/bin/env python3
"""Build the SynaOS cursor theme (XCursor): Bibata Modern shapes with slim outlines, recoloured to the AdepT
palette, plus the SynaOS blade arrow and link pointer (~/.config/rice/branding/cursor/blade*.svg).

Bibata (GPL-3.0, github.com/ful1e5/Bibata_Cursor) is fetched at a pinned tag into ~/.cache/syna/bibata; only its
SVGs and configs/normal/x.build.toml (hotspots, sizes, aliases) are read, none of its code runs. Colours replace
Bibata's placeholders: #00FF00 fill, #0000FF outline, #FF0000 accent. Needs rsvg-convert, xcursorgen, git.
    syna-cursor-build                 build SynaOS-Cursor into ~/.local/share/icons (dark fill, cyan outline)
    syna-cursor-build --name N --fill #rrggbb --outline #rrggbb --accent #rrggbb
    syna-cursor-build --preview [colour options]   labelled sheet of every cursor, opened in imv (builds nothing)
"""
import argparse, glob, os, re, shutil, subprocess, sys, tempfile, tomllib
from pathlib import Path

TAG = 'v2.0.7'
REPO = 'https://github.com/ful1e5/Bibata_Cursor.git'
CACHE = Path.home() / '.cache/syna/bibata' / TAG

p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
p.add_argument('--name', default='SynaOS-Cursor')
p.add_argument('--fill', default='#0a1014')
p.add_argument('--outline', default='#3fd4e6')
p.add_argument('--accent', default='#e359c9')
p.add_argument('--style', default='modern', choices=['original', 'modern'], help='Bibata shape set')
p.add_argument('--stroke', type=float, default=9, help='outline width (Bibata default 17, on a 256 canvas)')
p.add_argument('--no-shard', action='store_true', help='plain Bibata arrow and hand (no SynaOS blade)')
p.add_argument('--preview', action='store_true', help='render a labelled sheet of all cursors and open it')
args = p.parse_args()
for c in (args.fill, args.outline, args.accent):
    if not re.fullmatch(r'#[0-9a-fA-F]{6}', c):
        sys.exit(f'Not a #rrggbb colour: {c}')
if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,40}', args.name):
    sys.exit('Theme name: letters, digits, . _ - only')
for tool in ('rsvg-convert', 'xcursorgen', 'git'):
    if not shutil.which(tool):
        sys.exit(f'Missing {tool}' + (': sudo pacman -S --needed xorg-xcursorgen' if tool == 'xcursorgen' else ''))

if not (CACHE / 'svg/modern').is_dir():
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(['git', '-c', 'advice.detachedHead=false', 'clone', '-q', '--depth', '1', '--branch', TAG, REPO, str(CACHE)], check=True)

cfg = tomllib.loads((CACHE / 'configs/normal/x.build.toml').read_text())['cursors']
fallback = cfg.pop('fallback_settings')
sizes, delay = fallback['x11_sizes'], fallback.get('x11_delay', 40)
svgdir = CACHE / 'svg' / args.style
SHARD = Path.home() / '.config/rice/branding/cursor'
# key: (svg, hotspot x, y) on the 256 canvas; replaces Bibata's shape for that cursor
CUSTOM = {} if args.no_shard else {'left_ptr': (SHARD / 'blade.svg', 40, 24), 'hand2': (SHARD / 'blade-link.svg', 40, 24)}
out = Path.home() / '.local/share/icons' / args.name
work = Path(tempfile.mkdtemp(prefix='syna-cursor-'))
colours = {'#00FF00': args.fill, '#0000FF': args.outline, '#FF0000': args.accent}
# Bibata's hard-coded extras, mapped to the palette: spinner slices alternate accent/outline, corner wedges and other
# decoration take the accent (the magenta streak), status badges keep their meaning in brand colours.
EXTRA = {'#FCB813': args.accent, '#F05024': args.outline, '#7EBA41': args.accent, '#32A0DA': args.outline,
         '#FDBE2A': args.accent, '#4FADDF': args.accent, '#96C865': args.accent, '#F1613A': args.accent,
         '#FE0000': '#f0597f', '#06B231': '#3fe0a8', '#F27400': '#dfa35c', '#5F3BE4': args.accent,
         '#179DD8': args.outline, '#0A6857': '#3fe0a8'}
# Bibata's arrow paths (by their start point) -> replaced by the SynaOS blade at this scale, tip on the hotspot
ARROWS = {'M201.163 133.54': 1.0, 'M141.269 109.497': 0.62}
BLADE_TIP = (40, 24)


def blade_group(hx, hy, scale):
    inner = re.sub(r'(?s)^.*?<svg[^>]*>|</svg>\s*$', '', (SHARD / 'blade.svg').read_text())
    inner = re.sub(r'(?s)<!--.*?-->', '', inner)
    return (f'<g transform="translate({hx} {hy}) scale({scale}) translate({-BLADE_TIP[0]} {-BLADE_TIP[1]})">'
            f'{inner}</g>')


def render(svg, size, dest, hotspot=None):
    text = svg.read_text()
    if hotspot and svg.parent != SHARD and not args.no_shard:
        for start, scale in ARROWS.items():
            text = re.sub(r'<path[^>]*d="' + re.escape(start) + r'[^"]*"[^>]*/>',
                          lambda m: blade_group(hotspot[0], hotspot[1], scale), text, count=1)
    for a, b in EXTRA.items():
        text = re.sub(re.escape(a), b, text, flags=re.I)
    if svg.parent != SHARD:   # slim Bibata's outlines (most are 17 wide); the blade files set their own
        text = re.sub(r'stroke-width="([0-9.]+)"', lambda m: f'stroke-width="{float(m[1]) * args.stroke / 17:g}"', text)
    for a, b in colours.items():
        text = re.sub(re.escape(a), b, text, flags=re.I)
    subprocess.run(['rsvg-convert', '-w', str(size), '-h', str(size), '-o', str(dest)], input=text.encode(), check=True)


if args.preview:
    if not shutil.which('magick'):
        sys.exit('Missing magick (imagemagick) for --preview')
    tiles = []
    for key, c in cfg.items():
        pattern = c['png'].removesuffix('.png')
        frames = sorted(svgdir.glob(pattern + '.svg')) or sorted(svgdir.glob(f"{pattern.split('-*')[0]}/{pattern}.svg"))
        if key in CUSTOM:
            frames = [CUSTOM[key][0]]
        for i, svg in enumerate(frames[::max(1, len(frames) // 4)][:4] if len(frames) > 1 else frames):
            png = work / f'{key}-{i}.png'
            render(svg, 72, png, (c.get('x_hotspot', fallback['x_hotspot']), c.get('y_hotspot', fallback['y_hotspot'])))
            tiles.append((png, c.get('x11_name', key) + (f' {i + 1}' if len(frames) > 1 else '')))
    sheet = Path.home() / '.cache/syna' / f'cursor-preview-{args.name}.png'
    cmd = ['magick', 'montage']
    for png, label in tiles:
        cmd += ['-label', label, str(png)]
    cmd += ['-tile', '10x', '-geometry', '96x96+10+18', '-background', '#2a3640', '-fill', '#eff8fa',
            '-font', 'JetBrainsMono-NF-Regular', '-pointsize', '11', str(sheet)]
    subprocess.run(cmd, check=True)
    shutil.rmtree(work, ignore_errors=True)
    print('Preview:', sheet)
    if shutil.which('imv'):
        subprocess.Popen(['imv', str(sheet)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    sys.exit(0)

try:
    (out / 'cursors').mkdir(parents=True, exist_ok=False) if not out.exists() else None
    shutil.rmtree(out); (out / 'cursors').mkdir(parents=True)
    built = 0
    for key, c in cfg.items():
        pattern = c['png'].removesuffix('.png')
        frames = sorted(svgdir.glob(pattern + '.svg')) or sorted(svgdir.glob(f"{pattern.split('-*')[0]}/{pattern}.svg"))
        if key in CUSTOM:
            frames = [CUSTOM[key][0]]
        if not frames:
            print(f'skip {key}: no SVG', file=sys.stderr); continue
        xh, yh = c.get('x_hotspot', fallback['x_hotspot']), c.get('y_hotspot', fallback['y_hotspot'])
        if key in CUSTOM:
            xh, yh = CUSTOM[key][1], CUSTOM[key][2]
        lines = []
        for size in sizes:
            for i, svg in enumerate(frames):
                png = work / f'{key}-{size}-{i}.png'
                render(svg, size, png, (xh, yh))
                hx, hy = round(xh * size / 256), round(yh * size / 256)
                lines.append(f'{size} {hx} {hy} {png}' + (f' {delay}' if len(frames) > 1 else ''))
        conf = work / f'{key}.conf'
        conf.write_text('\n'.join(lines) + '\n')
        name = c.get('x11_name', key)
        subprocess.run(['xcursorgen', str(conf), str(out / 'cursors' / name)], check=True)
        for link in c.get('x11_symlinks', []):
            target = out / 'cursors' / link
            if not target.exists():
                os.symlink(name, target)
        built += 1
    (out / 'index.theme').write_text(f'[Icon Theme]\nName={args.name}\nComment=SynaOS cursor: Bibata {args.style.title()} {TAG} '
                                     f'(GPL-3.0), outline {args.stroke:g}, SynaOS blade arrow, recoloured {args.fill}/{args.outline}/{args.accent}\nInherits=Adwaita\n')
    print(f'Built {out} ({built} cursors, sizes {sizes[0]}-{sizes[-1]})')
finally:
    shutil.rmtree(work, ignore_errors=True)
