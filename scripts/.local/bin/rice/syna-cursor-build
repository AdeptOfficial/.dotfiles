#!/usr/bin/env python3
"""Build the SynaOS cursor theme (XCursor): Bibata Modern shapes layered like the AdepT emblem (black edge, magenta
line, cyan band, black fill), with the SynaOS arrow (~/.config/rice/branding/cursor/arrow.svg) as the pointer and
inside every Bibata cursor that carries an arrow (link, busy, badges).

Bibata (GPL-3.0, github.com/ful1e5/Bibata_Cursor) is fetched at a pinned tag into ~/.cache/syna/bibata; only its
SVGs and configs/normal/x.build.toml (hotspots, sizes, aliases) are read, none of its code runs. Colours replace
Bibata's placeholders: #00FF00 fill, #0000FF outline, #FF0000 accent. Needs rsvg-convert, xcursorgen, git.
    syna-cursor-build                 build SynaOS-Cursor into ~/.local/share/icons
    syna-cursor-build --flat          Bibata shapes with one slim outline instead of the emblem layers
    syna-cursor-build --name N --fill #rrggbb --outline #rrggbb --accent #rrggbb
    syna-cursor-build --preview [colour options]   labelled sheet of every cursor, opened in imv (builds nothing)
"""
import argparse, glob, os, re, shutil, subprocess, sys, tempfile, tomllib
from pathlib import Path

TAG = 'v2.0.7'
REPO = 'https://github.com/ful1e5/Bibata_Cursor.git'
CACHE = Path.home() / '.cache/syna/bibata' / TAG

p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
p.add_argument('--name', default='SynaOS-Cursor')
p.add_argument('--fill', default='#0a1014')
p.add_argument('--outline', default='#3fd4e6')
p.add_argument('--accent', default='#e359c9')
p.add_argument('--style', default='modern', choices=['original', 'modern'], help='Bibata shape set')
p.add_argument('--stroke', type=float, default=9, help='outline width with --flat (Bibata default 17, on a 256 canvas)')
p.add_argument('--no-shard', action='store_true', help='plain Bibata arrow (no SynaOS arrow)')
p.add_argument('--flat', action='store_true', help='one slim outline instead of the emblem layers')
p.add_argument('--preview', action='store_true', help='render a labelled sheet of all cursors and open it')
args = p.parse_args()
for c in (args.fill, args.outline, args.accent):
    if not re.fullmatch(r'#[0-9a-fA-F]{6}', c):
        sys.exit(f'Not a #rrggbb colour: {c}')
if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,40}', args.name):
    sys.exit('Theme name: letters, digits, . _ - only')
for tool in ('rsvg-convert', 'xcursorgen', 'git'):
    if not shutil.which(tool):
        sys.exit(f'Missing {tool}' + (': sudo pacman -S --needed xorg-xcursorgen' if tool == 'xcursorgen' else ''))

if not (CACHE / 'svg/modern').is_dir():
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(['git', '-c', 'advice.detachedHead=false', 'clone', '-q', '--depth', '1', '--branch', TAG, REPO, str(CACHE)], check=True)

cfg = tomllib.loads((CACHE / 'configs/normal/x.build.toml').read_text())['cursors']
fallback = cfg.pop('fallback_settings')
sizes, delay = fallback['x11_sizes'], fallback.get('x11_delay', 40)
svgdir = CACHE / 'svg' / args.style
SHARD = Path.home() / '.config/rice/branding/cursor'
ARROW_TIP = (40, 24)   # arrow.svg's tip, its hotspot
ARROW_LEAN = 38.7      # degrees the arrow leans left of straight up (bisector of its leg and wing)


def arrow_group(hx, hy, scale=1, turn=0, mirror=False):
    """arrow.svg's layers as a group with the tip moved to (hx, hy): scaled, turned clockwise, or mirrored about it."""
    inner = re.sub(r'(?s)^.*?<svg[^>]*>|</svg>\s*$', '', (SHARD / 'arrow.svg').read_text())
    inner = re.sub(r'(?s)<!--.*?-->', '', inner)
    return (f'<g transform="translate({hx} {hy}) rotate({turn}) scale({-scale if mirror else scale} {scale}) '
            f'translate({-ARROW_TIP[0]} {-ARROW_TIP[1]})">{inner}</g>')


def arrow_svg(hx, hy, **kw):
    return f'<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256" fill="none">{arrow_group(hx, hy, **kw)}</svg>'


# key: (svg file or text, hotspot x, y) on the 256 canvas; replaces Bibata's shape for that cursor. hand2 (clickable)
# shows the link cursor: the arrow with Bibata's chain badge. center_ptr points straight up, right_ptr up-right.
CUSTOM = {} if args.no_shard else {
    'left_ptr': (SHARD / 'arrow.svg', *ARROW_TIP), 'hand2': (svgdir / 'link.svg', 55, 17),
    'center_ptr': (arrow_svg(127, 17, turn=ARROW_LEAN), 127, 17), 'right_ptr': (arrow_svg(204, 17, mirror=True), 204, 17)}
out = Path.home() / '.local/share/icons' / args.name
work = Path(tempfile.mkdtemp(prefix='syna-cursor-'))
colours = {'#00FF00': args.fill, '#0000FF': args.outline, '#FF0000': args.accent}
# Bibata's hard-coded extras, mapped to the palette: spinner slices alternate accent/outline, corner wedges and other
# decoration take the accent (the magenta streak), status badges keep their meaning in brand colours.
EXTRA = {'#FCB813': args.accent, '#F05024': args.outline, '#7EBA41': args.accent, '#32A0DA': args.outline,
         '#FDBE2A': args.accent, '#4FADDF': args.accent, '#96C865': args.accent, '#F1613A': args.accent,
         '#FE0000': '#f0597f', '#06B231': '#3fe0a8', '#F27400': '#dfa35c', '#5F3BE4': args.accent,
         '#179DD8': args.outline, '#0A6857': '#3fe0a8', '#606060': args.fill}   # link badge: dark, its chain gets the band
# Bibata's arrow paths (by their start point) -> replaced by the SynaOS arrow at this scale, tip on the hotspot
ARROWS = {'M201.163 133.54': 1.0, 'M141.269 109.497': 1.0}   # busy arrow full size: its spinner is shrunk instead
def rings(text, line=16, band=28, edge=32):
    """Emblem layers on Bibata's shapes: fill-colour edge, accent line (outside the shape), outline-colour band
    (inside, clipped), shape fill. Visible widths on the 256 canvas: edge (edge-line)/2, line/2, band/2; these match
    arrow.svg (8, 8, 14). Colours are written as real values so the placeholder passes leave them alone."""
    n = [0]
    def ring(d, rule):
        n[0] += 1; cid = f'ring{n[0]}'
        return (f'<clipPath id="{cid}"><path {rule}d="{d}"/></clipPath>'
                f'<path {rule}d="{d}" fill="none" stroke="{args.outline}" stroke-width="{band}" clip-path="url(#{cid})"/>')
    def repl(m):
        tag = m.group(0)
        dm = re.search(r' d="([^"]+)"', tag)
        if not dm or 'class="syna"' in tag:   # the SynaOS arrow has its own layers
            return tag
        d, rule = dm.group(1), ('fill-rule="evenodd" ' if 'evenodd' in tag else '')
        if re.search(r'stroke="#0000FF"', tag, re.I):          # stroked outline: accent line, edge under it, band inside
            tag = re.sub(r'stroke-width="[0-9.]+"', f'stroke-width="{line}"', tag)
            tag = re.sub(r'stroke="#0000FF"', f'stroke="{args.accent}"', tag, flags=re.I)
            if 'stroke-linejoin' not in tag:
                tag = tag.replace('/>', ' stroke-linejoin="round"/>')
            dark = re.sub(r'stroke="[^"]+"', f'stroke="{args.fill}"', tag)
            dark = re.sub(r'stroke-width="[0-9.]+"', f'stroke-width="{edge}"', dark)
            return dark + tag + ring(d, rule)
        if re.search(r'fill="#0000FF"', tag, re.I) and 'stroke=' not in tag:   # outline drawn as a filled shape
            tag = re.sub(r'fill="#0000FF"', f'fill="{args.accent}"', tag, flags=re.I)
            dark = tag.replace('/>', f' stroke="{args.fill}" stroke-width="{edge - line}" stroke-linejoin="round"/>')
            return dark + tag   # under the shape, so only its outer half shows
        if re.search(r'fill="#00FF00"', tag, re.I) and 'stroke=' not in tag:   # body drawn on an outline-filled shape
            return tag + ring(d, rule)
        return tag
    return re.sub(r'<path[^>]*/>', repl, text)


BADGE, IBEAM = 0.65, 0.75   # scale of status badges, the text cursor
BADGE_LEFT = 12     # badges move this far left (256 canvas), over the arrow's wing / the hand
BADGE_DOWN = 12     # top-right badges (on arrows) also move this far down
# Bibata's top-right badge: rect 107.5,15.5 113x113, stroke 17 -> 130 across, centre (164, 72), corner (220.5, 15.5).
# Where it ends up after BADGE/LEFT/DOWN; the busy arrow's spinner (circle at 118,162, 158 across) goes to the same
# centre at the same size, so it reads as one more status badge.
BADGE_CENTRE = (220.5 + (164 - 220.5) * BADGE - BADGE_LEFT, 15.5 + (72 - 15.5) * BADGE + BADGE_DOWN)
IBEAM_WIDTH = 0.85  # the text cursor is also narrowed to this (same height)


def squeeze_x(d, sx, cx):
    """Scale a path's x coordinates around cx (absolute M/L/C/H/V/Z only, as Bibata writes them); strokes keep
    their width, unlike a scale transform."""
    out, cmd, i = [], '', 0
    for tok in re.findall(r'[A-Za-z]|-?[0-9]*\.?[0-9]+', d):
        if tok.isalpha():
            cmd, i = tok, 0; out.append(tok); continue
        v = float(tok)
        if cmd == 'H' or (cmd in 'MLC' and i % 2 == 0):
            v = cx + (v - cx) * sx
        i += 1; out.append(f'{v:g}')
    return ' '.join(out)


def shrink(content, factor, ax, ay):
    return f'<g transform="translate({ax} {ay}) scale({factor}) translate({-ax} {-ay})">{content}</g>'


def secondary(text, name, hotspot):
    """Shrink what sits beside the arrow so the arrow stays the main shape: status badges (Bibata draws them as one
    filter group: top-right on arrows, bottom-right on the dnd hands), the busy arrow's spinner (moved into the
    top-right badge spot), and the text cursor (around its hotspot, strokes kept at full width to match the set)."""
    if name == 'xterm':
        head = re.match(r'(?s).*?<svg[^>]*>', text).group(0)
        body = text[len(head):text.rindex('</svg>')]
        body = re.sub(r'stroke-width="([0-9.]+)"', lambda m: f'stroke-width="{float(m[1]) / IBEAM:g}"', body)
        body = re.sub(r' d="([^"]+)"', lambda m: f' d="{squeeze_x(m[1], IBEAM_WIDTH, hotspot[0])}"', body)
        return head + shrink(body, IBEAM, *hotspot) + '</svg>'
    if name.startswith('left_ptr_watch'):
        i = text.find('<circle')
        cx, cy = BADGE_CENTRE
        spinner = (f'<g transform="translate({cx:.1f} {cy:.1f}) scale({130 * BADGE / 158:.4f}) translate(-118 -162)">'
                   f'{text[i:text.rindex("</svg>")]}</g>')
        return text[:i] + spinner + '</svg>' if i > 0 else text
    m = re.search(r'(?s)<g filter="[^"]*">.*?</g>', text)
    if not m or not (name.startswith(('dnd-', 'dnd_')) or 'class="syna"' in text):   # badges only beside an arrow or a hand
        return text
    r = re.search(r'<rect x="([0-9.]+)" y="([0-9.]+)" width="([0-9.]+)"', m.group(0))
    ax, ay = (float(r[1]) + float(r[3]), float(r[2])) if r else (241.0, 241.0)
    badge = f'<g transform="translate({-BADGE_LEFT} {BADGE_DOWN if r else 0})">{shrink(m.group(0), BADGE, ax, ay)}</g>'
    return text[:m.start()] + badge + text[m.end():]


def render(svg, size, dest, hotspot=None):
    own = isinstance(svg, str) or svg.parent == SHARD   # SynaOS artwork (text or file), not a Bibata SVG
    text = svg if isinstance(svg, str) else svg.read_text()
    if hotspot and not own and not args.no_shard:
        for start, scale in ARROWS.items():
            text = re.sub(r'<path[^>]*d="' + re.escape(start) + r'[^"]*"[^>]*/>',
                          lambda m: arrow_group(hotspot[0], hotspot[1], scale), text, count=1)
    if not args.flat:
        text = rings(text)
    if not own:
        text = secondary(text, svg.stem, hotspot or (128, 128))
    for a, b in EXTRA.items():
        text = re.sub(re.escape(a), b, text, flags=re.I)
    if args.flat and not own:   # slim Bibata's outlines (most are 17 wide)
        text = re.sub(r'stroke-width="([0-9.]+)"', lambda m: f'stroke-width="{float(m[1]) * args.stroke / 17:g}"', text)
    for a, b in colours.items():
        text = re.sub(re.escape(a), b, text, flags=re.I)
    subprocess.run(['rsvg-convert', '-w', str(size), '-h', str(size), '-o', str(dest)], input=text.encode(), check=True)


if args.preview:
    if not shutil.which('magick'):
        sys.exit('Missing magick (imagemagick) for --preview')
    tiles = []
    for key, c in cfg.items():
        pattern = c['png'].removesuffix('.png')
        frames = sorted(svgdir.glob(pattern + '.svg')) or sorted(svgdir.glob(f"{pattern.split('-*')[0]}/{pattern}.svg"))
        if key in CUSTOM:
            frames = [CUSTOM[key][0]]
        for i, svg in enumerate(frames[::max(1, len(frames) // 4)][:4] if len(frames) > 1 else frames):
            png = work / f'{key}-{i}.png'
            hot = CUSTOM[key][1:] if key in CUSTOM else (c.get('x_hotspot', fallback['x_hotspot']), c.get('y_hotspot', fallback['y_hotspot']))
            render(svg, 72, png, hot)
            tiles.append((png, c.get('x11_name', key) + (f' {i + 1}' if len(frames) > 1 else '')))
    sheet = Path.home() / '.cache/syna' / f'cursor-preview-{args.name}.png'
    cmd = ['magick', 'montage']
    for png, label in tiles:
        cmd += ['-label', label, str(png)]
    cmd += ['-tile', '10x', '-geometry', '96x96+10+18', '-background', '#2a3640', '-fill', '#eff8fa',
            '-font', 'JetBrainsMono-NF-Regular', '-pointsize', '11', str(sheet)]
    subprocess.run(cmd, check=True)
    shutil.rmtree(work, ignore_errors=True)
    print('Preview:', sheet)
    if shutil.which('imv'):
        subprocess.Popen(['imv', str(sheet)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    sys.exit(0)

try:
    (out / 'cursors').mkdir(parents=True, exist_ok=False) if not out.exists() else None
    shutil.rmtree(out); (out / 'cursors').mkdir(parents=True)
    built = 0
    for key, c in cfg.items():
        pattern = c['png'].removesuffix('.png')
        frames = sorted(svgdir.glob(pattern + '.svg')) or sorted(svgdir.glob(f"{pattern.split('-*')[0]}/{pattern}.svg"))
        if key in CUSTOM:
            frames = [CUSTOM[key][0]]
        if not frames:
            print(f'skip {key}: no SVG', file=sys.stderr); continue
        xh, yh = c.get('x_hotspot', fallback['x_hotspot']), c.get('y_hotspot', fallback['y_hotspot'])
        if key in CUSTOM:
            xh, yh = CUSTOM[key][1], CUSTOM[key][2]
        lines = []
        for size in sizes:
            for i, svg in enumerate(frames):
                png = work / f'{key}-{size}-{i}.png'
                render(svg, size, png, (xh, yh))
                hx, hy = round(xh * size / 256), round(yh * size / 256)
                lines.append(f'{size} {hx} {hy} {png}' + (f' {delay}' if len(frames) > 1 else ''))
        conf = work / f'{key}.conf'
        conf.write_text('\n'.join(lines) + '\n')
        name = c.get('x11_name', key)
        subprocess.run(['xcursorgen', str(conf), str(out / 'cursors' / name)], check=True)
        for link in c.get('x11_symlinks', []):
            target = out / 'cursors' / link
            if not target.exists():
                os.symlink(name, target)
        built += 1
    (out / 'index.theme').write_text(f'[Icon Theme]\nName={args.name}\nComment=SynaOS cursor: Bibata {args.style.title()} {TAG} '
                                     f'(GPL-3.0), ' + (f'flat outline {args.stroke:g}' if args.flat else 'emblem layers') + f', SynaOS arrow, colours {args.fill}/{args.outline}/{args.accent}\nInherits=Adwaita\n')
    print(f'Built {out} ({built} cursors, sizes {sizes[0]}-{sizes[-1]})')
finally:
    shutil.rmtree(work, ignore_errors=True)
