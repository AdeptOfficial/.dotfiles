#!/bin/bash

# Launch or focus on a given TUI identified by the passed in as the command.
# Use by commands like syna-launch-wifi to ensure there is only one wifi configuration screen open.

APP_ID="io.adept.rice.$(basename "$1")"
LAUNCH_COMMAND="syna-launch-tui $@"

exec syna-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
