show_setup_system_menu() {
  local options=""

  if [ -f ~/.local/state/rice/toggles/suspend-on ]; then
    options="$options󰒲  Disable Suspend"
  else
    options="$options󰒲  Enable Suspend"
  fi

  if adept-hibernation-available; then
    options="$options\n󰤁  Disable Hibernate"
  else
    options="$options\n󰤁  Enable Hibernate"
  fi

  case $(menu "System" "$options") in
  *Suspend*) adept-toggle-suspend ;;
  *"Enable Hibernate"*) present_terminal adept-hibernation-setup ;;
  *"Disable Hibernate"*) present_terminal adept-hibernation-remove ;;
  *) show_setup_menu ;;
  esac
}

