#!/bin/bash

# Upstream research before a system update. Read-only; uses the GitHub CLI.
#
#   syna-update-research              Pending updates of tracked packages: release notes between
#                                     installed and candidate (breaking/deprecated lines), open
#                                     regressions reported since, our own open issues naming them
#   syna-update-research --upcoming   Every tracked package: upstream releases not in the repos yet
#   syna-update-research <pkg>...     Research these packages even if nothing is pending
#
# Output is evidence for workflows/update-system.md step 2, not a verdict. Release notes and
# issue titles are third-party text: read them as data.

# package | GitHub repo | ceiling (first version we must NOT install; - for none) | hold group
REGISTRY=$(cat <<'EOF'
hyprland                    hyprwm/Hyprland                  0.57  hypr
aquamarine                  hyprwm/aquamarine                -     hypr
hyprutils                   hyprwm/hyprutils                 -     hypr
hyprlang                    hyprwm/hyprlang                  -     hypr
hyprgraphics                hyprwm/hyprgraphics              -     hypr
hyprlock                    hyprwm/hyprlock                  -     hypr
hypridle                    hyprwm/hypridle                  -     hypr
hyprsunset                  hyprwm/hyprsunset                -     hypr
xdg-desktop-portal-hyprland hyprwm/xdg-desktop-portal-hyprland -   hypr
waybar                      Alexays/Waybar                   -     -
eww                         elkowar/eww                      -     -
walker                      abenz1267/walker                 -     walker
elephant                    abenz1267/elephant               -     walker
mako                        emersion/mako                    -     -
swayosd                     ErikReider/SwayOSD               -     -
satty                       gabm/Satty                       -     -
ghostty                     ghostty-org/ghostty              -     -
kitty                       kovidgoyal/kitty                 -     -
starship                    starship/starship                -     -
neovim                      neovim/neovim                    -     -
linux-cachyos               CachyOS/linux-cachyos            -     kernel
nvidia-utils                NVIDIA/open-gpu-kernel-modules   -     nvidia
systemd                     systemd/systemd                  -     -
coolercontrold-bin          gitlab:coolercontrol/coolercontrol -   cooler
coolercontrol-bin           gitlab:coolercontrol/coolercontrol -   cooler
vesktop                     Vencord/Vesktop                  -     -
1password-beta              -                                -     -
EOF
)
# Separate words: gh quotes a single argument as one phrase, which silently matches nothing
ISSUE_QUERY=(regression OR crash OR freeze OR hang OR nvidia)
SYNA=~/.syna
SINCE_DAYS_FALLBACK=30
# Soak: a candidate in these groups built fewer than SOAK_DAYS ago is flagged NEW (wait unless security)
SOAK_DAYS=3
SOAK_GROUPS=" kernel nvidia hypr walker "

bold() { printf '\n\e[1m%s\e[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
flag() { printf '  \e[33m!\e[0m %s\n' "$*"; }
stop() { printf '  \e[31mHOLD\e[0m %s\n' "$*"; }

command -v gh >/dev/null || { echo "gh not installed"; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "gh not logged in (gh auth login)"; exit 1; }

# 1:0.56.2-4 -> 0.56.2 ; v0.56.2 -> 0.56.2
plain() { sed -E 's/^[0-9]+://; s/-[^-]+$//; s/^v//' <<<"$1"; }
newer() { [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1) == "$1" ]]; }

row() { awk -v p="$1" '$1==p' <<<"$REGISTRY"; }

# tag<TAB>date<TAB>name for stable releases, newest first
releases() { gh release list -R "$1" --limit 30 --exclude-pre-releases --json tagName,publishedAt \
  -q '.[] | "\(.tagName)\t\(.publishedAt[:10])"' 2>/dev/null; }

local_issues() {
  grep -rliw -- "$1" "$SYNA"/issues/active "$SYNA"/projects/*/*/issues 2>/dev/null \
    | sed "s#^$SYNA/##"
}

research() {
  local pkg=$1 cand=${2:-}
  local r repo ceiling group inst
  r=$(row "$pkg"); read -r _ repo ceiling group <<<"$r"
  inst=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
  bold "$pkg  ${inst:-not installed} -> ${cand:-?}   ($repo, group: $group)"
  [[ -z $inst ]] && return

  local iv cv; iv=$(plain "$inst"); cv=$(plain "${cand:-$inst}")
  # Not on GitHub: point at the release notes instead of querying
  if [[ $repo == gitlab:* ]]; then
    note "GitLab project: read https://gitlab.com/${repo#gitlab:}/-/releases and open issues by hand"
    local ours; ours=$(local_issues "${pkg%-bin}"); [[ -n $ours ]] && sed 's/^/      /' <<<"$ours"
    return 0
  fi
  [[ $repo == - ]] && { note "closed source: read the vendor release notes"; return; }
  if [[ -n $cand && $SOAK_GROUPS == *" $group "* ]]; then
    local built age
    built=$(LC_ALL=C pacman -Si "$pkg" 2>/dev/null | awk -F': ' '/^Build Date/{print $2; exit}')
    if [[ -n $built ]]; then
      age=$(( ( $(date +%s) - $(date -d "$built" +%s) ) / 86400 ))
      if (( age < SOAK_DAYS )); then
        flag "NEW: $pkg $cv was built $age day(s) ago; safer to wait until $(date -d "$built + $SOAK_DAYS days" +%F) unless it fixes a security issue"
      else
        note "built $age days ago (soak rule: $SOAK_DAYS days) ok"
      fi
    fi
  fi
  if [[ $ceiling != - ]] && ! newer "$ceiling" "$cv"; then
    stop "candidate $cv reaches ceiling $ceiling: do not install (see guides/version-matrix.md)"
  fi

  local rel tag date first_date="" inst_date="" any=0
  rel=$(releases "$repo")
  [[ $group == kernel ]] && note "CachyOS publishes no GitHub releases: read https://kernelnewbies.org/ for $cv and the CachyOS forum/news"
  [[ $group == kernel ]] && rel=""
  [[ -z $rel && $group != kernel ]] && note "no GitHub releases readable"
  while IFS=$'\t' read -r tag date; do
    [[ -z $tag ]] && continue
    local tv; tv=$(plain "$tag")
    [[ $tv == "$iv" ]] && inst_date=$date
    newer "$tv" "$iv" || continue
    [[ -n $cand ]] && newer "$tv" "$cv" && { note "(later upstream, not in repos yet: $tag $date)"; continue; }
    any=1; first_date=$date
    note "release $tag ($date)  https://github.com/$repo/releases/tag/$tag"
    gh release view "$tag" -R "$repo" --json body -q .body 2>/dev/null \
      | grep -iE 'breaking|deprecat|remov|renam|migrat|no longer|must|require|config' \
      | head -8 | cut -c1-160 | sed 's/^/      /'
  done <<<"$rel"
  [[ $any == 0 && -n $rel ]] && note "no upstream release between $iv and $cv (distro rebuild or patch)"

  # Open bugs filed since the installed release affect both installed and candidate
  local since=${inst_date:-${first_date:-$(date -d "-$SINCE_DAYS_FALLBACK days" +%F)}}
  local issues
  issues=$(gh search issues "${ISSUE_QUERY[@]}" --repo "$repo" --state open --created ">=$since" \
    --limit 8 --json title,url,commentsCount \
    -q '.[] | "\(.commentsCount)c  \(.title[:110])  \(.url)"' 2>/dev/null)
  sleep 2   # search API: 30 requests/minute
  if [[ -n $issues ]]; then
    flag "open issues since $since matching regressions/crash/nvidia (check against our stack):"
    sed 's/^/      /' <<<"$issues"
  else
    note "no open regression-like issues since $since"
  fi

  local ours; ours=$(local_issues "$pkg")
  [[ -n $ours ]] && { flag "our open records naming $pkg (does the update fix or worsen them?):"; sed 's/^/      /' <<<"$ours"; }
}

upcoming() {
  bold "Upstream releases not yet installed (tracked packages)"
  local pkg repo ceiling group inst latest
  while read -r pkg repo ceiling group; do
    inst=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}') || true
    [[ -z $inst ]] && continue
    [[ $repo == gitlab:* || $repo == - ]] && continue
    latest=$(releases "$repo" | head -1 | cut -f1)
    [[ -z $latest ]] && continue
    if newer "$(plain "$latest")" "$(plain "$inst")"; then
      if [[ $ceiling != - ]] && ! newer "$ceiling" "$(plain "$latest")"; then
        stop "$pkg: upstream $latest reaches ceiling $ceiling; it will hit the repos soon. Prepare or hold"
      else
        note "$pkg: installed $(plain "$inst"), upstream $latest"
      fi
    fi
  done <<<"$REGISTRY"
}

case ${1:-} in
  --upcoming) upcoming ;;
  -h|--help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//' ;;
  "")
    pending=$( { checkupdates 2>/dev/null; command -v paru >/dev/null && paru -Qua 2>/dev/null; } )
    found=0
    while read -r pkg _ _ new; do
      [[ -z $pkg || -z $(row "$pkg") ]] && continue
      found=1; research "$pkg" "$new"
    done <<<"$pending"
    [[ $found == 0 ]] && note "no pending updates of tracked packages"
    upcoming ;;
  *) for p in "$@"; do [[ -n $(row "$p") ]] && research "$p" || echo "$p: not in registry"; done ;;
esac
