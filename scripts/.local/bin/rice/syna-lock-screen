#!/bin/bash

# Locks the system using hyprlock, but not before ensuring 1password has also been locked, and the screensaver stopped.
#   syna-lock-screen               lock now (keybind SUPER+CTRL+L, idle, menu)
#   syna-lock-screen --preview [s] show the real lock screen for theme work: any key or mouse move unlocks without a
#                                  password during the first s seconds (default 30); 1password and screensaver untouched

if [[ ${1:-} == --preview ]]; then
  pidof hyprlock >/dev/null && { echo "Already locked."; exit 1; }
  exec hyprlock --quiet --grace "${2:-30}"
fi

# Lock the screen
pidof hyprlock || hyprlock &

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f io.adept.rice.screensaver
