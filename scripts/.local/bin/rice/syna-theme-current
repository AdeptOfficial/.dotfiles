#!/bin/bash

# Prints the active theme's display name (override label, else title-cased theme ID)

id=$(cat "$HOME/.config/themes/current.name" 2>/dev/null) || { echo Unknown; exit 0; }
label="$HOME/.config/themes/.overrides/$id.name"
if [[ -f "$label" ]]; then
  cat "$label"
else
  printf '%s\n' "$id" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
fi
