#!/bin/bash
# Switch between desktop and laptop hardware profiles
# Works with the local override pattern: *.local.conf (hyprlang) and *.local.lua (Lua config).
# Both are kept in step until the hyprlang config is retired (Hyprland 0.57 drops it).
#
# Usage: syna-profile-switch [desktop|laptop|backup|restore|status]

HYPR_CONFIG="$HOME/.config/hypr"
TEMPLATES_DIR="$HOME/.dotfiles/hypr/.config/hypr/templates"
CONFIGS=(monitors input autostart)
# local-file suffix : template suffix
FORMATS=("local.conf:example" "local.lua:lua.example")

# Backup current .local.conf files
backup_local_configs() {
  echo "Backing up current configs..."
  for f in "${CONFIGS[@]}"; do
    for fmt in "${FORMATS[@]}"; do
      local file="$HYPR_CONFIG/${f}.${fmt%%:*}"
      if [[ -f "$file" ]]; then
        cp "$file" "${file}.backup"
        echo "  ${f}.${fmt%%:*} → ${f}.${fmt%%:*}.backup"
      fi
    done
  done
}

# Apply profile templates to .local.conf
apply_profile() {
  local profile="$1"
  backup_local_configs
  echo "Applying $profile profile..."
  for f in "${CONFIGS[@]}"; do
    for fmt in "${FORMATS[@]}"; do
      local template="$TEMPLATES_DIR/${f}.${profile}.${fmt#*:}"
      local target="$HYPR_CONFIG/${f}.${fmt%%:*}"
      if [[ -f "$template" ]]; then
        cp "$template" "$target"
        echo "  ${f}.${fmt%%:*} ← ${f}.${profile}.${fmt#*:}"
      else
        echo "  Warning: Template $template not found, creating empty file"
        touch "$target"
      fi
    done
  done
}

# Reload Hyprland if running
reload_if_running() {
  if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]] || pgrep -x Hyprland > /dev/null; then
    hyprctl reload
    echo "Hyprland config reloaded"
  else
    echo "Hyprland not running - changes will apply on next start"
  fi
}

# Restore from backups
do_restore() {
  echo "Restoring from backups..."
  for f in "${CONFIGS[@]}"; do
    for fmt in "${FORMATS[@]}"; do
      local backup="$HYPR_CONFIG/${f}.${fmt%%:*}.backup"
      local target="$HYPR_CONFIG/${f}.${fmt%%:*}"
      if [[ -f "$backup" ]]; then
        cp "$backup" "$target"
        echo "  ${f}.${fmt%%:*} ← ${f}.${fmt%%:*}.backup"
      else
        echo "  Warning: No backup for ${f}.${fmt%%:*}"
      fi
    done
  done
  reload_if_running
  echo "Restore complete"
}

# Show status
show_status() {
  echo "Local Override Pattern Status"
  echo "=============================="
  echo ""
  echo "Current local files:"
  for f in "${CONFIGS[@]}"; do
    for fmt in "${FORMATS[@]}"; do
      local file="$HYPR_CONFIG/${f}.${fmt%%:*}"
      if [[ -f "$file" ]]; then
        local size
        size=$(stat -c%s "$file" 2>/dev/null || echo "?")
        echo "  ${f}.${fmt%%:*} ($size bytes)"
      else
        echo "  ${f}.${fmt%%:*} (MISSING)"
      fi
    done
  done
  echo ""
  echo "Available templates:"
  for profile in desktop laptop default; do
    local count=0
    for f in "${CONFIGS[@]}"; do
      for fmt in "${FORMATS[@]}"; do
        [[ -f "$TEMPLATES_DIR/${f}.${profile}.${fmt#*:}" ]] && ((count++))
      done
    done
    echo "  $profile: $count/6 templates (.conf + .lua)"
  done
  echo ""
  echo "Backups:"
  local backup_count=0
  for f in "${CONFIGS[@]}"; do
    [[ -f "$HYPR_CONFIG/${f}.local.conf.backup" ]] && ((backup_count++))
  done
  echo "  $backup_count/3 backup files present"
}

case "$1" in
  desktop)
    apply_profile "desktop"
    reload_if_running
    echo "Desktop profile active"
    ;;

  laptop)
    apply_profile "laptop"
    reload_if_running
    echo "Laptop profile active"
    ;;

  backup)
    backup_local_configs
    echo "Backup complete"
    ;;

  restore)
    do_restore
    ;;

  status)
    show_status
    ;;

  *)
    echo "Usage: syna-profile-switch [desktop|laptop|backup|restore|status]"
    echo ""
    echo "Commands:"
    echo "  desktop  Switch to desktop profile (dual monitor, gaming mouse)"
    echo "  laptop   Switch to laptop profile (G14, trackpad)"
    echo "  backup   Save current .local.conf as .local.conf.backup"
    echo "  restore  Restore from .local.conf.backup files"
    echo "  status   Show current config status and available templates"
    echo ""
    echo "Note: Auto-backs up before profile switch"
    exit 1
    ;;
esac
