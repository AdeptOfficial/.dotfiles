#!/usr/bin/env python3
"""What is installed, since when, who installed it, and what needs it. Read-only.

  syna-pkg-inventory            Packages installed on purpose, oldest first
  syna-pkg-inventory --mine     Only the ones added after the first day (not installer/setup script)
  syna-pkg-inventory --orphans  Dependencies nothing needs any more (review before removing)
  syna-pkg-inventory --big N    The N largest packages installed on purpose

"First installed" comes from /var/log/pacman.log (pacman's own Install Date changes on every
upgrade). Origin: "installer" = CachyOS install day, "setup" = listed in ~/.dotfiles/install.sh,
"you" = added later. "Last used" is not available: the root filesystem is mounted noatime.
"""
import os, re, subprocess, sys

SETUP = os.path.expanduser("~/.dotfiles/install.sh")
# Orphans that are used without a declared dependency (Steam compatibility tools, scripts)
IN_USE = {
    "proton-cachyos-native": "Steam compatibility tool (games set to proton-cachyos)",
    "proton-cachyos-slr": "Steam compatibility tool (games set to proton-cachyos-slr)",
    "sassc": "syna-theme-engine.py compiles SCSS with it",
}


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def first_installed():
    first, day1 = {}, None
    with open("/var/log/pacman.log", errors="replace") as f:
        for line in f:
            m = re.match(r"\[(\S+)\] \[ALPM\] installed (\S+) ", line)
            if m:
                day1 = day1 or m.group(1)[:10]
                first.setdefault(m.group(2), m.group(1)[:10])
    return first, day1


def info(names):
    if not names:
        return []
    out = run("expac", "-Q", "%n\t%m\t%N\t%d", *names)
    rows = []
    for line in out.splitlines():
        n, size, reqby, desc = (line.split("\t") + [""] * 4)[:4]
        rows.append((n, int(size or 0), reqby.split(), desc))
    return rows


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode in ("-h", "--help"):
        print(__doc__.strip()); return
    first, day1 = first_installed()
    foreign = set(run("pacman", "-Qmq").split())
    setup = open(SETUP).read() if os.path.exists(SETUP) else ""
    names = run("pacman", "-Qdtq" if mode == "--orphans" else "-Qeq").split()
    rows = []
    for n, size, reqby, desc in info(names):
        d = first.get(n, "?")
        if re.search(r"(^|\s)" + re.escape(n) + r"(\s|\\|$)", setup): origin = "setup"
        elif d == day1: origin = "installer"
        else: origin = "you"
        if mode == "--mine" and origin != "you":
            continue
        note = IN_USE.get(n, "needed by " + ", ".join(reqby[:3]) if reqby else "")
        rows.append((d, n, origin, "AUR" if n in foreign else "repo", size, note, desc))
    if mode == "--big":
        rows.sort(key=lambda r: -r[4]); rows = rows[: int(sys.argv[2]) if len(sys.argv) > 2 else 20]
    else:
        rows.sort()
    print(f"{'first':<10}  {'package':<32} {'origin':<9} {'src':<4} {'size':>7}  note / description")
    for d, n, origin, src, size, note, desc in rows:
        print(f"{d:<10}  {n:<32} {origin:<9} {src:<4} {size / 1048576:>6.0f}M  {note or desc[:60]}")
    total = sum(r[4] for r in rows) / 1073741824
    print(f"\n{len(rows)} packages, {total:.1f} GiB" + ("  (orphans: check notes before removing)" if mode == "--orphans" else ""))


if __name__ == "__main__":
    main()
