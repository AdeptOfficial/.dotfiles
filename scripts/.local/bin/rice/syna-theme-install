#!/bin/bash

# syna-theme-install: Install a new theme from a git repo
# Usage: syna-theme-install <git-repo-url>
# Example: syna-theme-install https://github.com/user/custom-theme

if [ -z "$1" ]; then
  echo "Usage: syna-theme-install <git-repo-url>"
  echo ""
  echo "Example: syna-theme-install https://github.com/user/my-theme"
  echo ""
  INPUT=$(gum input --placeholder="Git URL for theme repo" --header="")
else
  INPUT="$1"
fi

if [ -z "$INPUT" ]; then
  exit 1
fi

# Extract theme name from URL
REPO_URL="$INPUT"
THEME_NAME=$(basename "$REPO_URL" .git | sed -E 's/^syna-//; s/-theme$//')

THEMES_DIR="$HOME/.config/themes"
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Remove existing theme if present
if [ -d "$THEME_PATH" ]; then
  echo "Removing existing $THEME_NAME..."
  rm -rf "$THEME_PATH"
fi

echo "Installing $THEME_NAME from $REPO_URL..."

# Clone the repo directly to ~/.config/themes
if ! git clone "$REPO_URL" "$THEME_PATH" 2>/dev/null; then
  echo "Error: Failed to clone theme repo."
  exit 1
fi

# Remove .git from cloned theme (keep it clean)
rm -rf "$THEME_PATH/.git"

echo -e "\e[32mTheme '$THEME_NAME' installed!\e[0m"
echo "Run 'syna-theme-set $THEME_NAME' to activate it."
