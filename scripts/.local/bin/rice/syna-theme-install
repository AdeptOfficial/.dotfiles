#!/bin/bash

# Clones a theme from an HTTPS git URL (network), validates it and adds it to ~/.config/themes

set -euo pipefail
INPUT="${1:-}"
[[ -n $INPUT ]] || INPUT=$(gum input --placeholder="https://host/owner/theme.git")
# HTTPS only: no option injection, local paths, or git transport helpers.
[[ $INPUT =~ ^https://[a-zA-Z0-9][a-zA-Z0-9.-]+/[^[:space:]?#]+$ ]] || { echo 'Use an HTTPS repository URL' >&2; exit 1; }
THEME_NAME=$(basename -- "${INPUT%/}" .git | sed -E 's/^syna-//; s/-theme$//')
HELPER="$(dirname "$0")/syna-theme-safe.py"
THEME_PATH=$(python3 "$HELPER" validate "$THEME_NAME")
[[ ! -e $THEME_PATH ]] || { echo 'Theme already exists; remove or rename it first' >&2; exit 1; }
mkdir -p "$HOME/.config/themes"
STAGING=$(mktemp -d "$HOME/.config/themes/.install.XXXXXXXX")
trap 'rm -rf -- "$STAGING"' EXIT
# No hooks from a user/global template directory or alternate protocols.
git -c core.hooksPath=/dev/null -c protocol.allow=never -c protocol.https.allow=always clone --template= --depth 1 -- "$INPUT" "$STAGING/theme"
python3 "$HELPER" check "$STAGING/theme"
# Keep provenance; theme-set will stage only validated palette and image data.
mv -- "$STAGING/theme" "$THEME_PATH"
printf 'Installed %s. Activate with: syna-theme-set %s\n' "$THEME_NAME" "$THEME_NAME"
