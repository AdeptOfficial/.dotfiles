#!/bin/bash

# Omarchy leftover: opens HEY mail (mailto links) as a web app; HEY is not used here

url="$1"
web_url="https://app.hey.com"

# Handle mailto: URLs
if [[ $url =~ ^mailto: ]]; then
  email=$(echo "$url" | sed 's/mailto://')
  web_url="https://app.hey.com/messages/new?to=$email"
fi

exec syna-launch-webapp "$web_url"
