#!/bin/bash

# Run a named hook, like post-update (available in ~/.config/rice/hooks/post-update).

set -e

if [[ $# -lt 1 ]]; then
  echo "Usage: syna-hook [name] [args...]"
  exit 1
fi

HOOK=$1
[[ $HOOK =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || { echo 'Invalid hook name' >&2; exit 2; }
HOOK_PATH="$HOME/.config/rice/hooks/$1"
shift

if [[ -f $HOOK_PATH ]]; then
  bash "$HOOK_PATH" "$@"
fi
