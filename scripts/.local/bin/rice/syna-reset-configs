#!/bin/bash
# Reset rice configs to defaults from ~/.config/rice/defaults

set -e

if [ "$EUID" -eq 0 ]; then
  echo "Error: This script should not be run as root"
  exit 1
fi

RICE_DEFAULTS="$HOME/.config/rice/defaults"

if [[ ! -d "$RICE_DEFAULTS" ]]; then
  echo "Error: Rice defaults not found at $RICE_DEFAULTS"
  echo "Make sure the rice package is stowed: cd ~/.dotfiles && stow rice"
  exit 1
fi

echo "Resetting rice configs to defaults"

# Copy rice config defaults
if [[ -d "$RICE_DEFAULTS/config" ]]; then
  cp -R "$RICE_DEFAULTS/config/"* ~/.config/
fi

# Generate theme config file from current theme
current_theme=$(readlink ~/.config/themes/current 2>/dev/null | xargs basename)
if [[ -n "$current_theme" ]]; then
  syna-theme-set "$current_theme"
fi

echo "Done."
