#!/bin/bash

# Guided system update: checks, research summary, install, post-check, restart advice, and an
# automatic check after the restart. Plain language; asks before every change.
# Replaces the Omarchy-era chain (syna-update-perform etc.), which updated without checks.
#
#   syna-update                 Run the whole flow (interactive; needs your terminal)
#   syna-update --after-reboot  Run by syna-update-after-reboot.service at login after a kernel update
#   syna-update --write-note    Write the update note for the last pacman transaction
#   syna-update --test-lts      Arm a one-time check of the LTS fallback kernel for the next login
#   syna-update --test-vfio     Arm a one-time check of the VFIO (GPU passthrough) boot entry
#
# Notes: ~/.syna/docs/updates/YYYY-MM-DD.md. Undo: syna-update-undo. Guide: ~/.syna/guides/system-update.md

STATE=~/.local/state/syna
NOTES=~/.syna/docs/updates
PENDING=$STATE/post-reboot-pending
LTS_PENDING=$STATE/lts-test-pending
VFIO_PENDING=$STATE/vfio-test-pending
# Each checker pipeline uses pipefail INSIDE its command substitution; capture $? immediately.
# PIPESTATUS in the parent shell cannot see the checker inside $(...).
strip() { sed 's/\x1b\[[0-9;]*m//g'; }
step() { printf '\n\e[1;36m%s\e[0m\n' "$*"; }
good() { printf '  \e[32m%s\e[0m\n' "$*"; }
bad()  { printf '  \e[31m%s\e[0m\n' "$*"; }
line() { printf '  %s\n' "$*"; }
ask()  { local a; read -r -p "  $1 [y/N] " a; [[ $a == [yY]* ]]; }

# Package changes of the last full upgrade, from pacman.log ("upgraded name (old -> new)")
last_transaction() {
  awk '/\[PACMAN\] starting full system upgrade/{buf=""} /\[ALPM\] (upgraded|installed|removed|downgraded) /{buf=buf $0 "\n"} END{printf "%s", buf}' /var/log/pacman.log \
    | sed -E 's/^\[[^]]+\] \[ALPM\] //'
}

# One note per update run; a second run on the same day gets -2, -3, …
new_note_path() {
  local f="$NOTES/$(date +%F).md" n=2
  while [[ -f $f ]]; do f="$NOTES/$(date +%F)-$n.md"; n=$((n + 1)); done
  echo "$f"
}

write_note() {   # $1 = post-check verdict
  mkdir -p "$NOTES" "$STATE"
  local f tx crit restart="no (no kernel change)"
  f=$(new_note_path); tx=$(last_transaction)
  crit=$(grep -E '^(upgraded|downgraded|installed|removed) (linux-cachyos|nvidia|lib32-nvidia|systemd |mkinitcpio|limine|hyprland|aquamarine|hyprutils|mesa|glibc|ca-certificates)' <<<"$tx")
  grep -qE '^(upgraded|downgraded) linux-cachyos(-lts)? ' <<<"$tx" && restart="yes (kernel changed)"
  {
    echo "# Update $(date +%F)"
    echo
    local done_at; done_at=$(grep '\[ALPM\] transaction completed' /var/log/pacman.log | tail -1 | grep -oE '^\[[^]]+' | tr -d '[' | cut -c1-16 | tr T ' ')
    echo "**Status:** installed ${done_at:-$(date '+%F %H:%M')}; restart needed: $restart"
    echo "**Post-check (before restart):** $1"
    if [[ $restart == yes* ]]; then
      echo "**After restart:** pending"
    else
      echo "**After restart:** not scheduled (no kernel change); restart affected apps/session as advised"
    fi
    echo
    echo "## Important changes"
    echo
    if [[ -n $crit ]]; then sed 's/^/- /' <<<"$crit"; else echo "- none of the boot/desktop-critical packages"; fi
    echo
    echo "## How to undo"
    echo
    echo "- One package (with its group, e.g. the kernel and its NVIDIA module): \`syna-update-undo <package>\`."
    echo "  It reinstalls the previous version from the package cache and asks first."
    echo "- New kernel won't start: pick **LTS** in the boot menu, then \`syna-update-undo linux-cachyos\`."
    echo "- Everything: the boot menu's **Snapshots** entry has the pre-update snapshot (snap-pac). Boot it,"
    echo "  check, then \`sudo limine-snapper-restore\`. Ask an agent first: this rolls back every package."
    echo
    echo "## All $(grep -c . <<<"$tx") package changes"
    echo
    sed 's/^/- /' <<<"$tx"
  } >"$f"
  echo "$f"
}

# Fallback test: verify the LTS kernel once, so the boot-menu fallback is known to work
lts_test() {
  [[ -f $LTS_PENDING ]] || return 0
  if [[ $(uname -r) != *lts* ]]; then
    notify-send -a "Syna update" "LTS test still armed" "This boot used $(uname -r). Next restart, pick linux-cachyos-lts in the boot menu."
    return 0
  fi
  local out rc f="$NOTES/lts-test-$(date +%F).md"
  out=$(set -o pipefail; syna-update-check boot 2>&1 </dev/null | strip); rc=$?
  mkdir -p "$NOTES"
  { echo "# LTS fallback test $(date +%F)"; echo
    echo "**Result:** $( ((rc == 0)) && echo passed || echo FAILED ) on $(uname -r), $(date '+%F %H:%M')"; echo
    echo '```'; echo "$out"; echo '```'; } >"$f"
  rm -f "$LTS_PENDING"
  if (( rc == 0 )); then
    notify-send -a "Syna update" "LTS fallback verified" "$(uname -r) boots with all checks passing. Restart to return to the normal kernel."
  else
    notify-send -u critical -a "Syna update" "LTS fallback has problems" "Run syscheck; result saved in ${f/#$HOME/\~}"
  fi
}

# VFIO entry test: the passthrough boot settings took effect and the GTX 1080 can go to a VM
vfio_test() {
  [[ -f $VFIO_PENDING ]] || return 0
  if ! grep -q pcie_acs_override /proc/cmdline; then
    notify-send -a "Syna update" "VFIO test still armed" "This boot was not the VFIO entry. Next restart, pick linux-cachyos-vfio in the boot menu."
    return 0
  fi
  local out rc fails=0 r="" f="$NOTES/vfio-test-$(date +%F).md" d grp iso
  out=$(set -o pipefail; syna-update-check boot 2>&1 </dev/null | strip); rc=$?; (( rc )) && fails=$((fails + 1))
  for d in 0000:10:00.0 0000:10:00.1; do
    if [[ $(basename "$(readlink -f /sys/bus/pci/devices/$d/driver 2>/dev/null)") == vfio-pci ]]; then r+="ok    $d on vfio-pci"$'\n'
    else r+="FAIL  $d not on vfio-pci"$'\n'; fails=$((fails + 1)); fi
  done
  # A VM takes a whole IOMMU group: it must hold only the GPU's own functions
  grp=$(ls /sys/bus/pci/devices/0000:10:00.0/iommu_group/devices/ 2>/dev/null | tr '\n' ' ')
  if [[ -n $grp && -z $(tr ' ' '\n' <<<"$grp" | grep -v '^$' | grep -v '^0000:10:00\.') ]]; then r+="ok    IOMMU group holds only the GPU: $grp"$'\n'
  else r+="FAIL  IOMMU group shared with other devices: $grp"$'\n'; fails=$((fails + 1)); fi
  iso=$(cat /sys/devices/system/cpu/isolated 2>/dev/null)
  [[ -n $iso ]] && r+="ok    CPUs reserved for the VM: $iso"$'\n' || { r+="FAIL  no isolated CPUs"$'\n'; fails=$((fails + 1)); }
  if virsh -c qemu:///system list --all >/dev/null 2>&1; then r+="ok    libvirt reachable (VMs: $(virsh -c qemu:///system list --all --name | grep -c .))"$'\n'
  else r+="FAIL  libvirt not reachable"$'\n'; fails=$((fails + 1)); fi
  mkdir -p "$NOTES"
  { echo "# VFIO boot entry test $(date +%F)"; echo
    echo "**Result:** $( ((fails == 0)) && echo passed || echo "FAILED ($fails)" ) on $(uname -r), $(date '+%F %H:%M')"
    echo "Not covered: starting the passthrough VM itself (do that by hand: win11-gpu)."; echo
    echo '```'; printf '%s' "$r"; echo; echo "$out"; echo '```'; } >"$f"
  rm -f "$VFIO_PENDING"
  if (( fails == 0 )); then
    notify-send -a "Syna update" "VFIO entry verified" "GTX 1080 isolated and ready for passthrough. Start your VM to finish the test, then restart to the normal entry."
  else
    notify-send -u critical -a "Syna update" "VFIO entry has problems" "$fails check(s) failed; see ${f/#$HOME/\~}"
  fi
}

after_reboot() {
  lts_test
  vfio_test
  [[ -f $PENDING ]] || exit 0
  # On the LTS kernel the update check would test the wrong kernel: keep it armed for the normal one
  if [[ $(uname -r) == *lts* ]]; then
    notify-send -a "Syna update" "Running the LTS kernel" "The update check waits for the normal kernel. If the new kernel failed to start, see the update note's undo section."
    exit 0
  fi
  local out rc f verdict
  out=$(set -o pipefail; syna-update-check boot 2>&1 </dev/null | strip); rc=$?
  f=$(<"$PENDING"); verdict=$(tail -1 <<<"$out" | sed 's/^ *//')
  [[ -f $f ]] && sed -i "s|^\*\*After restart:\*\* pending|**After restart:** $(date '+%F %H:%M') on $(uname -r): $verdict|" "$f"
  rm -f "$PENDING"
  if [[ $rc -eq 0 ]]; then
    notify-send -a "Syna update" "Update verified" "Kernel $(uname -r) is running and all checks passed. AUR updates next: paru -Sua"
  else
    notify-send -u critical -a "Syna update" "Update check found problems" "Open a terminal and run: syscheck"
  fi
}

# AUR updates last: community build recipes, so paru shows each recipe's changes before building
offer_aur() {
  local aur; aur=$(paru -Qua 2>/dev/null | grep -c .)
  (( aur > 0 )) || return 0
  echo
  line "$aur AUR update(s) waiting. These are community build recipes: paru shows each recipe's"
  line "changes before building. Read them, especially for apps marked 'runs as root' in step 1."
  ask "Run the AUR updates now (paru -Sua)?" && paru -Sua
}

case ${1:-} in
  --after-reboot) after_reboot; exit 0 ;;
  --test-lts)
    mkdir -p "$STATE"; date +%F >"$LTS_PENDING"
    echo "LTS test armed. Restart, pick linux-cachyos-lts in the boot menu, and log in."
    echo "About a minute later a notification shows the result; then restart back to the normal kernel."
    exit 0 ;;
  --test-vfio)
    mkdir -p "$STATE"; date +%F >"$VFIO_PENDING"
    echo "VFIO test armed. Restart, pick linux-cachyos-vfio in the boot menu, and log in."
    echo "About a minute later a notification shows the result. Then start your passthrough VM to finish."
    exit 0 ;;
  --write-note)   write_note "${2:-see syna-update-check post}"; exit 0 ;;
  -h|--help)      sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

[[ -t 0 ]] || { echo "syna-update is interactive: run it in your own terminal."; exit 2; }

if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  step "An update is already installed and waiting for a restart"
  if [[ -f $PENDING ]]; then line "After you restart and log in, the check runs by itself and shows a notification."
  else line "Run: syna-update-check post   then restart, then: syscheck"; fi
  exit 0
fi

step "Step 1 of 4: checking the system (asks for your password once)"
pre=$(set -o pipefail; syna-update-check pre 2>&1 | tee /dev/tty | strip); prerc=$?
if (( prerc != 0 )); then
  bad "The check found a problem (FAIL above). Nothing was changed. Ask an agent: \"update the system\"."
  exit 1
fi
n=$(grep -oE '[0-9]+ repo packages' <<<"$pre" | grep -oE '^[0-9]+')
[[ -z $n ]] && { good "No system (repo) updates."; offer_aur; exit 0; }
needs_restart=no; grep -q 'boot/desktop-critical: linux-cachyos' <<<"$pre" && needs_restart=yes

step "Step 2 of 4: looking for known problems with these updates"
research=$(set -o pipefail; syna-update-research 2>&1 | strip); researchrc=$?
if (( researchrc != 0 )); then
  bad "Research could not be completed. Stopping before installation."
  printf '%s\n' "$research"
  exit 1
fi
holds=$(grep 'HOLD' <<<"$research")
soak=$(grep 'NEW:' <<<"$research")
leads=$(grep -c '^  ! open issues' <<<"$research")
if [[ -n $holds ]]; then
  bad "Something must be held back:"; sed 's/^ */    /' <<<"$holds"
  line "Stopping here, nothing changed. Ask an agent to plan around it: \"update the system\"."
  exit 1
fi
[[ -n $soak ]] && { line "Very new releases (not tested by many people yet):"; sed 's/^ */    /' <<<"$soak"; }
line "$leads package(s) have open bug reports worth a look. Most never affect a given machine."
line "Details: syna-update-research   (an agent can judge them against your hardware)"

step "Ready: $n updates$( [[ $needs_restart == yes ]] && echo ', including a new kernel (restart needed afterwards)')"
[[ -n $soak ]] && line "Unless this fixes a security problem, waiting a few days for the new releases is the safer choice."
ask "Install now?" || { line "Nothing changed. Run syna-update again when you're ready."; exit 0; }

step "Step 3 of 4: installing (pacman asks for confirmation)"
sudo pacman -Syu || { bad "pacman stopped or failed. Read its message above; nothing else was run."; exit 1; }

step "Step 4 of 4: checking the result before you restart"
post=$(set -o pipefail; syna-update-check post 2>&1 | tee /dev/tty | strip); postrc=$?
f=$(write_note "$(tail -1 <<<"$post" | sed 's/^ *//')")
echo
if (( postrc != 0 )); then
  bad "DO NOT RESTART. The check found a problem (FAIL above)."
  line "Your current session is fine. Ask an agent with the output above. Note: ${f/#$HOME/\~}"
  exit 1
fi
good "All checks passed. Update note: ${f/#$HOME/\~}"
if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  echo "$f" >"$PENDING"
  line "Restart when convenient. After you log in, the check runs by itself and shows a notification."
  line "If the new kernel doesn't start: pick LTS in the boot menu (the note explains how to undo)."
else
  line "No kernel change: no restart required."
  # Running programs keep the old version in memory until restarted
  tx=$(last_transaction)
  if grep -qE '^upgraded (pipewire|libpipewire|wireplumber)' <<<"$tx"; then
    line "Audio (PipeWire) was updated: log out and back in, or restart audio (a second of silence):"
    line "  systemctl --user restart pipewire pipewire-pulse wireplumber"
  fi
  if grep -qE '^upgraded (hyprland|aquamarine|hyprutils|hyprlang|hyprgraphics) ' <<<"$tx"; then
    line "Hyprland or its libraries were updated: log out and back in when convenient."
  fi
fi

offer_aur
