#!/bin/bash

# Reload opencode configuration (used by Syna theme switching).
# opencode 2.x: ask the background service to reload; never start it. (The v1 SIGUSR2 no longer matches: the binary is opencode.exe.)

command -v opencode >/dev/null || exit 0
opencode service status 2>/dev/null | grep -q '^http' || exit 0
timeout 10 opencode reload >/dev/null 2>&1 || true
