#!/bin/bash
# Create/restore btrfs snapshots using snapper

set -e

COMMAND="$1"

if [[ -z $COMMAND ]]; then
  echo "Usage: adept-snapshot <create|restore>" >&2
  exit 1
fi

if ! command -v snapper &>/dev/null; then
  echo "snapper not installed"
  exit 127
fi

case "$COMMAND" in
create)
  DESC="$(adept-version)"
  snapper create --type single --cleanup-algorithm number --print-number --description "$DESC"
  ;;
restore)
  if (($# < 2)); then
    echo "Usage: adept-snapshot restore <number>"
    echo ""
    echo "Available snapshots:"
    snapper list
    exit 1
  fi
  NUMBER=$2
  echo "Restoring snapshot $NUMBER..."
  sudo snapper undochange "$NUMBER"..0
  echo "Restored. Reboot recommended."
  ;;
*)
  echo "Unknown command: $COMMAND"
  echo "Usage: adept-snapshot <create|restore>"
  exit 1
  ;;
esac
