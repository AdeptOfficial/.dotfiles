#!/bin/bash

# Screenshot using grimblast (captures overlay layers) + satty (annotation)
# Usage: syna-cmd-screenshot [region|window|output] [clipboard]
#   region (default): Select area
#   window: Capture active window
#   output: Capture focused monitor
#   clipboard: Skip annotation, copy directly
#
# Safety: Includes timeout watchdog to prevent Hyprland freeze if grimblast crashes

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${RICE_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots}"

# Timeout in seconds - kills hyprpicker/slurp if screenshot takes too long
SCREENSHOT_TIMEOUT=30

# Cleanup function to ensure hyprpicker doesn't hang
cleanup() {
  pkill -9 hyprpicker 2>/dev/null
  pkill -9 slurp 2>/dev/null
  # Kill the watchdog if it's still running
  [[ -n "$WATCHDOG_PID" ]] && kill "$WATCHDOG_PID" 2>/dev/null
}

# Always cleanup on exit (normal or crash)
trap cleanup EXIT

if [[ ! -d "$OUTPUT_DIR" ]]; then
  notify-send "Screenshot directory does not exist: $OUTPUT_DIR" -u critical -t 3000
  exit 1
fi

# Cancel any existing selection
if pkill slurp 2>/dev/null; then
  pkill -9 hyprpicker 2>/dev/null
  exit 0
fi

MODE="${1:-region}"
PROCESSING="${2:-edit}"

# Map old mode names for compatibility
case "$MODE" in
  smart) MODE="region" ;;
  windows) MODE="window" ;;
  fullscreen) MODE="output" ;;
esac

# Check if --freeze is supported (fallback if not)
FREEZE=""
if [[ "$MODE" == "region" ]]; then
  if grimblast --help 2>&1 | grep -q "\-\-freeze\|\-f"; then
    FREEZE="--freeze"
  fi
fi

case "$MODE" in
  region)
    TARGET="area"
    ;;
  window)
    TARGET="active"
    ;;
  output)
    TARGET="output"
    ;;
  *)
    TARGET="area"
    ;;
esac

# Start watchdog timer in background - kills screenshot tools if they hang
(
  sleep "$SCREENSHOT_TIMEOUT"
  pkill -9 hyprpicker 2>/dev/null
  pkill -9 slurp 2>/dev/null
  pkill -9 grimblast 2>/dev/null
  notify-send "Screenshot timed out" "Killed hung screenshot process after ${SCREENSHOT_TIMEOUT}s" -u warning -t 5000
) &
WATCHDOG_PID=$!

if [[ $PROCESSING == "clipboard" ]]; then
  # Direct to clipboard with notification
  grimblast --notify $FREEZE copy $TARGET
else
  # Capture with grimblast, annotate with satty
  grimblast $FREEZE save $TARGET - | satty --filename - \
    --output-filename "$OUTPUT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
fi

# Kill the watchdog since we completed successfully
kill "$WATCHDOG_PID" 2>/dev/null
