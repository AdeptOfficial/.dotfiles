#!/bin/bash

# Launch a floating terminal with the Syna logo presentation, then execute the command passed in, and finally end with the syna-show-done presentation.
# Used by actions such as Update System.

cmd="$*"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=io.adept.rice.terminal --title=Rice -e bash -c '
syna-show-logo
bash -c "$1"
result=$?
if (( result == 0 )); then
  syna-show-done
elif (( result != 130 )); then
  printf "Command failed (exit %s). Review the output above.\n" "$result" >&2
  [[ -t 0 ]] && read -r -p "Press Enter to close…" answer
fi
exit "$result"
' bash "$cmd"
