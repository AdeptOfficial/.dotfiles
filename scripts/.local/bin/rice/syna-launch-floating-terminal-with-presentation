#!/bin/bash

# Launch a floating terminal with the Omarchy logo presentation, then execute the command passed in, and finally end with the syna-show-done presentation.
# Used by actions such as Update System.

cmd="$*"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=io.adept.rice.terminal --title=Rice -e bash -c "syna-show-logo; $cmd; if [ \$? -ne 130 ]; then syna-show-done; fi"
