#!/bin/bash
# First-run setup (called from autostart on fresh install)
# For dotfiles setups, this is mostly a no-op.

FIRST_RUN_MODE=~/.local/state/rice/first-run.mode

if [[ -f "$FIRST_RUN_MODE" ]]; then
  rm -f "$FIRST_RUN_MODE"

  # Refresh application caches
  syna-refresh-applications

  echo "First run complete"
fi
