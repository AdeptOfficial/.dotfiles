#!/bin/bash

# Choose DNS for the NetworkManager uplinks (wired bridge br0, Wi-Fi): Automatic (from DHCP: router or LAN DNS
# server), Cloudflare, Quad9 or custom. No sudo: NetworkManager lets the logged-in user change connections.
# systemd-resolved stays in charge (resolved.conf is not touched); Tailscale's DNS and Docker/libvirt bridges
# are left alone. Rewritten 2026-10-22: the Omarchy version targeted systemd-networkd, which this machine
# does not use.
#   syna-setup-dns [Automatic|Cloudflare|Quad9|Custom|Show]

set -euo pipefail

# Active connections that carry normal traffic; bridge ports are skipped (their DNS lives on the bridge)
uplinks() {
  nmcli -t -f NAME,TYPE,DEVICE connection show --active | while IFS=: read -r name type dev; do
    case $type in 802-11-wireless | 802-3-ethernet | bridge) ;; *) continue ;; esac
    [[ $dev == docker* || $dev == br-* || $dev == virbr* ]] && continue
    [[ -n $(nmcli -g connection.master connection show "$name") ]] && continue
    printf '%s\t%s\n' "$name" "$dev"
  done
}

show() {
  echo "Current DNS per link (systemd-resolved):"
  resolvectl dns | grep -v ':\s*$' | sed 's/^/  /'
}

# apply <ipv4 servers> <ipv6 servers> <ignore DHCP DNS: yes|no> <dns-over-tls: -1 default|1 opportunistic>
apply() {
  local name dev
  while IFS=$'\t' read -r name dev; do
    nmcli connection modify "$name" ipv4.dns "$1" ipv6.dns "$2" \
      ipv4.ignore-auto-dns "$3" ipv6.ignore-auto-dns "$3" connection.dns-over-tls "$4"
    nmcli device reapply "$dev" >/dev/null   # applies the change without taking the link down
    echo "  $name ($dev): updated"
  done < <(uplinks)
}

choice=${1:-}
if [[ -z $choice ]]; then
  show
  echo
  echo "Cloudflare/Quad9/Custom replace the DNS your network hands out (e.g. a LAN DNS server with ad"
  echo "blocking or local names). Automatic restores it."
  choice=$(gum choose --height 7 --header "Select DNS" Automatic Cloudflare Quad9 Custom Show)
fi

case $choice in
Automatic | DHCP)
  apply "" "" no -1 ;;
Cloudflare)
  apply "1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com" \
    "2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com" yes 1 ;;
Quad9)
  apply "9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net" \
    "2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net" yes 1 ;;
Custom)
  read -rp "DNS servers (space-separated, IPv4 and/or IPv6): " servers
  [[ -n ${servers// /} ]] || { echo "No servers given; nothing changed."; exit 1; }
  v4="" v6=""
  for s in $servers; do
    if [[ $s == *:* ]]; then v6+="$s "; else v4+="$s "; fi
  done
  apply "${v4% }" "${v6% }" yes -1 ;;
Show)
  show; exit 0 ;;
*)
  echo "Usage: syna-setup-dns [Automatic|Cloudflare|Quad9|Custom|Show]" >&2; exit 2 ;;
esac

echo
show
