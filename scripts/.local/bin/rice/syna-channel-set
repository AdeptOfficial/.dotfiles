#!/bin/bash

# Set the release channel (legacy script - not used on standalone CachyOS setup).

if (($# == 0)); then
  echo "Usage: syna-channel-set [stable|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") syna-branch-set "master" && syna-refresh-pacman "stable" && sudo pacman -Suu --noconfirm ;;
"edge") syna-branch-set "master" && syna-refresh-pacman "edge" ;;
"dev") syna-branch-set "dev" && syna-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

syna-update -y
