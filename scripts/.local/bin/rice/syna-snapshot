#!/bin/bash
# Create/restore btrfs snapshots using snapper

set -e

COMMAND="$1"

if [[ -z $COMMAND ]]; then
  echo "Usage: syna-snapshot <create|restore>" >&2
  exit 1
fi

if ! command -v snapper &>/dev/null; then
  echo "snapper not installed"
  exit 127
fi

case "$COMMAND" in
create)
  DESC="$(syna-version)"
  snapper create --type single --cleanup-algorithm number --print-number --description "$DESC"
  ;;
restore)
  if (($# < 2)); then
    echo "Usage: syna-snapshot restore <number>"
    echo ""
    echo "Available snapshots:"
    snapper list
    exit 1
  fi
  NUMBER=$2
  [[ $NUMBER =~ ^[1-9][0-9]*$ ]] || { echo 'Snapshot must be a positive number' >&2; exit 2; }
  echo 'This replaces live root files. It does not restore /home or the matching kernel on /boot.'
  read -r -p "Type snapshot $NUMBER to confirm live rollback: " answer
  [[ $answer == "$NUMBER" ]] || { echo 'Nothing changed'; exit 1; }
  echo "Restoring snapshot $NUMBER..."
  sudo snapper undochange "$NUMBER"..0
  syna-update-check post
  echo "Root files restored. Review the post-check and boot recovery guide before restarting."
  ;;
*)
  echo "Unknown command: $COMMAND"
  echo "Usage: syna-snapshot <create|restore>"
  exit 1
  ;;
esac
