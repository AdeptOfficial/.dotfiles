#!/bin/bash

restart_services() {
  # Restart elephant if running as systemd service
  if systemctl --user is-enabled elephant.service &>/dev/null; then
    systemctl --user restart elephant.service
  fi

  # Restart walker - kill and relaunch as gapplication service
  if pgrep -x walker >/dev/null; then
    pkill -x walker
    sleep 0.5
  fi
  # Start walker in background (gapplication service mode)
  walker --gapplication-service &>/dev/null &
  disown
  echo "Walker restarted"
}

if [[ $EUID -eq 0 ]]; then
  SCRIPT_OWNER=$(stat -c '%U' "$0")
  USER_UID=$(id -u "$SCRIPT_OWNER")
  systemd-run --uid="$SCRIPT_OWNER" --setenv=XDG_RUNTIME_DIR="/run/user/$USER_UID" \
    bash -c "$(declare -f restart_services); restart_services"
else
  restart_services
fi
