#!/bin/bash

# Legacy script - not used on standalone CachyOS setup.
# Original purpose: switch between Omarchy release channels.

# Take backup of existing files
sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak

if [[ $1 == "edge" ]]; then
  sudo cp -f ~/.config/rice/defaults/pacman/pacman-edge.conf /etc/pacman.conf
  sudo cp -f ~/.config/rice/defaults/pacman/mirrorlist-edge /etc/pacman.d/mirrorlist
  echo "Setting channel to edge"
else
  sudo cp -f ~/.config/rice/defaults/pacman/pacman-stable.conf /etc/pacman.conf
  sudo cp -f ~/.config/rice/defaults/pacman/mirrorlist-stable /etc/pacman.d/mirrorlist
  echo "Setting channel to stable"
fi

echo

# Reset all package DBs and then update
sudo pacman -Syyu --noconfirm
