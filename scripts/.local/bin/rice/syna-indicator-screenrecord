#!/bin/bash

# Waybar module: prints a stop-recording icon JSON while gpu-screen-recorder records, else empty text.
# The always-on replay buffer (gsr-ui, "-r <seconds>") does not count as recording.

if pgrep -af "^gpu-screen-recorder" | grep -qv -- " -r [0-9]"; then
  echo '{"text": "󰻂", "tooltip": "Stop recording", "class": "active"}'
else
  echo '{"text": ""}'
fi
