#!/bin/bash

# Waybar module: prints a stop-recording icon JSON while gpu-screen-recorder records, else empty text.
# Only processes writing a file (-o) count: not the always-on replay buffer (gsr-ui, "-r <seconds>")
# and not gsr-ui's short --info/--list-* probes.

if pgrep -af "^gpu-screen-recorder" | grep -- " -o " | grep -qv -- " -r [0-9]"; then
  echo '{"text": "󰻂", "tooltip": "Stop recording", "class": "active"}'
else
  echo '{"text": ""}'
fi
