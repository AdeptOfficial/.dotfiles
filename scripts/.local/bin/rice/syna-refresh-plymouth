#!/bin/bash

# Reinstall the Syna boot splash from dotfiles and rebuild the boot images (main + LTS via the Limine
# hooks, VFIO via its own rebuild script). Theme source and preview: ~/.config/rice/defaults/plymouth/syna/
# Never bare `mkinitcpio -P`: plymouth-set-default-theme -R goes through limine-mkinitcpio, which
# re-signs the UKIs and updates Limine's hashes. Rollback: sudo plymouth-set-default-theme -R omarchy

set -e
src=~/.config/rice/defaults/plymouth/syna

sudo install -d -m 755 /usr/share/plymouth/themes/syna
sudo install -m 644 "$src"/syna.plymouth "$src"/syna.script "$src"/images/*.png /usr/share/plymouth/themes/syna/
sudo plymouth-set-default-theme -R syna
[[ -x /usr/local/bin/limine-vfio-rebuild ]] && sudo /usr/local/bin/limine-vfio-rebuild

echo
echo "Done. Check with: syna-update-check post"
