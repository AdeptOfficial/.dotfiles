#!/bin/bash
set -e

# Attempt to reinstall all default packages and reset all the default configs.

echo -e "This will reinstall all the default packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  syna-reinstall-git
  syna-reinstall-pkgs
  syna-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && syna-cmd-reboot
fi
