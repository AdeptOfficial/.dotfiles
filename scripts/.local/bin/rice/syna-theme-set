#!/bin/bash

if [[ -z $1 ]]; then
  echo "Usage: syna-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/themes/current"
NEXT_THEME_PATH="$HOME/.config/themes/next-theme"
THEMES_PATH="$HOME/.config/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ -d "$THEMES_PATH/$THEME_NAME" ]]; then
  THEME_PATH="$THEMES_PATH/$THEME_NAME"
else
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Symlink static configs from theme folder (instead of copying)
# This makes theme edits live without re-running theme-set
for item in "$THEME_PATH"/*; do
  name=$(basename "$item")
  # Skip backgrounds - handled separately by syna-theme-bg-next
  [[ "$name" == "backgrounds" ]] && continue
  ln -sf "$item" "$NEXT_THEME_PATH/$name"
done

# Symlink backgrounds folder if it exists
if [[ -d "$THEME_PATH/backgrounds" ]]; then
  ln -sf "$THEME_PATH/backgrounds" "$NEXT_THEME_PATH/backgrounds"
fi

# Generate dynamic configs from templates (overwrites symlinks for templated files)
syna-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" > "$HOME/.config/themes/current.name"

# Change background with theme
~/.local/bin/rice/syna-theme-bg-next

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  syna-restart-waybar
fi
syna-restart-swayosd
syna-restart-terminal
syna-restart-hyprctl
syna-restart-btop
syna-restart-opencode
syna-restart-mako
syna-theme-set-walker

# Change app-specific themes
syna-theme-set-gnome
syna-theme-set-browser
syna-theme-set-vscode
syna-theme-set-obsidian

# Call hook on theme set
syna-hook theme-set "$THEME_NAME"
