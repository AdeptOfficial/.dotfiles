#!/bin/bash

# syna-theme-set-walker: Update walker theme CSS with current theme colors
# Called by syna-theme-set when switching themes

WALKER_STYLE="$HOME/.config/rice/defaults/walker/themes/rice/style.css"
THEME_WALKER_CSS="$HOME/.config/themes/current/walker.css"

# Check if files exist
if [[ ! -f "$THEME_WALKER_CSS" ]]; then
  echo "Warning: No walker.css in current theme"
  exit 0
fi

if [[ ! -f "$WALKER_STYLE" ]]; then
  echo "Warning: Walker style.css not found"
  exit 0
fi

# Read color definitions from theme's walker.css
COLORS=$(grep '@define-color' "$THEME_WALKER_CSS")

if [[ -z "$COLORS" ]]; then
  echo "Warning: No color definitions found in theme walker.css"
  exit 0
fi

# Create new style.css with updated colors
# Keep everything after the color definitions
STYLE_BODY=$(sed -n '/^\* {$/,$p' "$WALKER_STYLE")

# Write new style.css
cat > "$WALKER_STYLE" << EOF
/* Colors from current theme - auto-generated by syna-theme-set-walker */
$COLORS

$STYLE_BODY
EOF

# Restart walker to apply changes
if pgrep -x walker >/dev/null; then
  syna-restart-walker
fi
