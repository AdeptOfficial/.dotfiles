#!/bin/bash
# Toggle eww dashboard widget on the focused monitor

# Start daemon if not running
if ! pgrep -x "eww" > /dev/null; then
    eww daemon &
    sleep 0.5
fi

# Get focused monitor ID
MONITOR=$(hyprctl monitors -j | jq '.[] | select(.focused==true) | .id')

# Check if dashboard is open
OPEN=$(eww active-windows 2>/dev/null | grep -c "dashboard")

if [[ "$OPEN" -gt 0 ]]; then
    eww close dashboard
else
    eww update active-tab="dashboard" cal-day=$(date +%d) cal-month=$(date +%m) cal-year=$(date +%Y)
    eww open dashboard --screen "$MONITOR"
fi
