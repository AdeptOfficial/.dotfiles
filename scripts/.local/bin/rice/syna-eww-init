#!/bin/bash
# Start one daemon; hover zones are disabled in the dashboard configuration.
exec 9>"${XDG_RUNTIME_DIR:?}/syna-eww-init.lock"
flock -w 3 9 || exit 0
if timeout 1 eww ping >/dev/null 2>&1; then
    exit 0
fi
mkdir -p "$HOME/.cache/eww"
# Do not let the daemon inherit the startup lock or a short-lived terminal pipe.
timeout 3 eww daemon 9>&- >>"$HOME/.cache/eww/daemon.log" 2>&1

# Hold startup lock until the IPC socket is accepting requests.
for attempt in {1..20}; do
    timeout 1 eww ping >/dev/null 2>&1 && exit 0
    sleep 0.1
done
exit 1
