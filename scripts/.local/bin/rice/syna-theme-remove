#!/bin/bash

# syna-theme-remove: Remove a theme by name
# Usage: syna-theme-remove <theme-name>

# Directories to exclude (system/internal folders)
EXCLUDE_DIRS="current|next-theme|templates|backgrounds"

if [ -z "$1" ]; then
  # Use -L to follow symlinks (themes dir may be symlinked from dotfiles)
  mapfile -t extra_themes < <(find -L ~/.config/themes -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | grep -Ev "^($EXCLUDE_DIRS)$" | sort)

  if [[ ${#extra_themes[@]} -gt 0 ]]; then
    THEME_NAME=$(printf '%s\n' "${extra_themes[@]}" | gum choose --header="Remove theme")
  else
    echo "No themes available to remove."
    exit 1
  fi
else
  THEME_NAME="$1"
fi

THEMES_DIR="$HOME/.config/themes"
THEME_PATH=$(python3 "$(dirname "$0")/syna-theme-safe.py" validate "$THEME_NAME") || exit 1

# Ensure a theme was selected
if [ -z "$THEME_NAME" ]; then
  exit 1
fi

# Check if theme exists before attempting removal
if [ ! -d "$THEME_PATH" ]; then
  echo "Error: Theme '$THEME_NAME' not found."
  exit 1
fi

# Check if it's the current theme
CURRENT_THEME=$(cat "$THEMES_DIR/current.name" 2>/dev/null)
if [ "$THEME_NAME" = "$CURRENT_THEME" ]; then
  echo "Error: Cannot remove the currently active theme."
  echo "Switch to a different theme first."
  exit 1
fi

# Use the same reversible, locked archive operation as the theme picker.
python3 - "$(dirname "$0")/syna-theme-customize.py" "$THEME_NAME" <<'PY'
import importlib.util, sys
spec = importlib.util.spec_from_file_location('custom', sys.argv[1])
custom = importlib.util.module_from_spec(spec)
spec.loader.exec_module(custom)
try:
    print('Theme archived:', custom.remove_theme(sys.argv[2]))
except (OSError, ValueError) as error:
    sys.exit(str(error))
PY
