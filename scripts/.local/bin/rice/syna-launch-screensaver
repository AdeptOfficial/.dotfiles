#!/bin/bash

# Launch the screensaver in the default terminal with the correct font configuration.

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f io.adept.rice.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/rice/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')
terminal=$(xdg-terminal-exec --print-id)

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$m\" })"

  case $terminal in
  *Alacritty*)
    hyprctl dispatch "hl.dsp.exec_cmd([[alacritty --class=io.adept.rice.screensaver --config-file ~/.config/rice/defaults/alacritty/screensaver.toml -e syna-cmd-screensaver]])"
    ;;
  *ghostty*)
    hyprctl dispatch "hl.dsp.exec_cmd([[ghostty --class=io.adept.rice.screensaver --config-file=$HOME/.config/rice/defaults/ghostty/screensaver --font-size=18 -e syna-cmd-screensaver]])"
    ;;
  *kitty*)
    hyprctl dispatch "hl.dsp.exec_cmd([[kitty --class=io.adept.rice.screensaver --override font_size=18 --override window_padding_width=0 -e syna-cmd-screensaver]])"
    ;;
  *)
    notify-send "✋  Screensaver only runs in Alacritty, Ghostty, or Kitty"
    ;;
  esac
done

hyprctl dispatch "hl.dsp.focus({ monitor = \"$focused\" })"
