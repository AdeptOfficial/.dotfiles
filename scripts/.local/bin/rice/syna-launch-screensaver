#!/bin/bash

# Launch the screensaver in the default terminal with the correct font configuration.

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f io.adept.rice.screensaver >/dev/null && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/rice/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')
terminal=$(xdg-terminal-exec --print-id)

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch focusmonitor "$m" >/dev/null

  case $terminal in
  *Alacritty*)
    hyprctl dispatch exec -- \
      alacritty --class=io.adept.rice.screensaver \
      --config-file ~/.config/rice/defaults/alacritty/screensaver.toml \
      -e syna-cmd-screensaver >/dev/null
    ;;
  *ghostty*)
    hyprctl dispatch exec -- \
      ghostty --class=io.adept.rice.screensaver \
      --config-file=~/.config/rice/defaults/ghostty/screensaver \
      --font-size=18 \
      -e syna-cmd-screensaver >/dev/null
    ;;
  *kitty*)
    hyprctl dispatch exec -- \
      kitty --class=io.adept.rice.screensaver \
      --override font_size=18 \
      --override window_padding_width=0 \
      -e syna-cmd-screensaver >/dev/null
    ;;
  *)
    notify-send "✋  Screensaver only runs in Alacritty, Ghostty, or Kitty"
    ;;
  esac
done

hyprctl dispatch focusmonitor "$focused" >/dev/null
