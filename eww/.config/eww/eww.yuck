; Dashboard widget definitions - Caelestia-style layout

; ============ Variables ============
(defvar active-tab "dashboard")
(defvar cal-day 0)
(defvar cal-month 0)
(defvar cal-year 0)
(defpoll calendar_year :interval "60s" :initial "1970" `date +%Y`)

(defpoll weather :interval "10m"
  :initial '{"temp": "--", "condition": "Loading", "icon": "☁️", "city": ""}'
  `~/.config/eww/scripts/weather/weather.sh`)

(defpoll sysinfo :interval "30s"
  :initial '{"distro": "Loading", "wm": "...", "uptime": "..."}'
  `~/.config/eww/scripts/sysinfo/sysinfo.sh`)

; Media info via deflisten (instant updates on play/pause/track change)
(deflisten media :initial '{"status":"stopped","title":"","artist":"","album":"","art":"","position":0,"duration":0,"position_fmt":"0:00","duration_fmt":"0:00","player":"","players":[],"volume":50,"muted":false}'
  `~/.config/eww/scripts/media/media-listen.sh`)

; ============ Media Tab Variables ============
(defvar selected-player "")
(defvar show-visualizer false)
(defpoll player-audio :interval "1s" :run-while {active-tab == "media"}
  :initial '{"available":false,"player":"","volume":0,"muted":false,"label":"No player connected","control_label":"Player","tooltip":"Player volume"}'
  `python3 ~/.config/eww/scripts/media/audio-volume.py`)

; Audio visualizer - cava output as Unicode bars
(deflisten cava :initial "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁"
  `~/.config/eww/scripts/media/cava-eww.sh`)

; Performance metrics (CPU, RAM, GPU)
(deflisten perf :initial "{}"
  `~/.config/eww/scripts/performance/perf.sh`)



(defpoll calendar_day :interval "60s"
  :initial "13"
  `date '+%d'`)

(defpoll calendar_weekday :interval "60s"
  :initial "Mon"
  `date '+%a'`)

(defpoll calendar_month_num :interval "60s"
  :initial "01"
  `date '+%m'`)

(defpoll current_time :interval "1s"
  :initial "00:00:00"
  `date '+%H:%M:%S'`)

(defpoll current_hour :interval "1s"
  :initial "00"
  `date '+%H'`)

(defpoll current_minute :interval "1s"
  :initial "00"
  `date '+%M'`)

(defpoll current_date :interval "60s"
  :initial "01/01"
  `date '+%m/%d'`)

; ============ Time Display ============
(defwidget time-display []
  (box :class "time-display" :halign "center"
    (label :class "time-text" :text current_time)))

; ============ Tab Navigation ============
(defwidget tabs []
  (box :class "tabs" :orientation "h" :space-evenly true :spacing 0
    (button :class {active-tab == "dashboard" ? "tab active" : "tab"}
            :onclick `eww update active-tab="dashboard"`
            (label :class "tab-icon" :text "󰕮"))
    (button :class {active-tab == "media" ? "tab active" : "tab"}
            :onclick `eww update active-tab="media"`
            (label :class "tab-icon" :text "󰎈"))
    (button :class {active-tab == "performance" ? "tab active" : "tab"}
            :onclick `eww update active-tab="performance"`
            (label :class "tab-icon" :text "󰓅"))
    (button :class {active-tab == "workspaces" ? "tab active" : "tab"}
            :onclick `eww update active-tab="workspaces"`
            (label :class "tab-icon" :text "󰕰"))))

; ============ Weather Widget ============
(defwidget weather-widget []
  (box :class "surface-card weather-box" :orientation "v" :space-evenly false :spacing 12 :hexpand true
    (label :class "section-label" :text "WEATHER" :halign "start")
    (box :orientation "h" :space-evenly false :spacing 16 :valign "center" :vexpand true
      (label :class "weather-icon" :text {weather?.icon ?: "☁️"})
      (box :orientation "v" :space-evenly false :spacing 4 :hexpand true
        (label :class "weather-temp" :text "${weather?.temp ?: '--'}°C" :halign "start")
        (label :class "weather-condition" :text {weather?.condition ?: "Loading weather"} :limit-width 26 :halign "start")))))

; ============ Profile Widget ============
(defwidget profile-widget []
  (box :class "surface-card profile-box" :orientation "v" :space-evenly false :spacing 12 :hexpand true :vexpand true :valign "fill"
    (label :class "section-label" :text "YOUR SYSTEM" :halign "start")
    (box :orientation "h" :space-evenly false :spacing 16 :halign "start" :valign "center" :hexpand true
      (box :class "profile-pic"
        (image :class "profile-img" :path "${EWW_CONFIG_DIR}/assets/profile.png" :image-width 56 :image-height 56))
      (box :orientation "v" :space-evenly false :spacing 6 :valign "center"
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "sysinfo-icon" :text "󰣇")
          (label :class "sysinfo-text" :text {sysinfo?.distro ?: "..."}))
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "sysinfo-icon" :text "󰍹")
          (label :class "sysinfo-text" :text {sysinfo?.wm ?: "..."}))
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "sysinfo-icon" :text "󰅐")
          (label :class "sysinfo-text" :text "up ${sysinfo?.uptime ?: '...'}"))))))

; ============ Media Widget ============
(defwidget media-widget []
  (box :class "surface-card media-box" :orientation "v" :space-evenly false :spacing 12 :hexpand true :vexpand true
    (box :orientation "h" :space-evenly false
      (label :class "section-label" :text "NOW PLAYING" :halign "start" :hexpand true)
      (button :class "text-action" :tooltip "Open media controls" :onclick "eww update active-tab=media" "Open →"))
    (box :orientation "v" :space-evenly false :spacing 8 :valign "center" :vexpand true
      (label :class "media-empty-icon" :text {media?.status == "Playing" ? "󰎈" : "󰐊"} :halign "center")
      (label :class "media-title" :text {(media?.title ?: "") != "" ? media.title : "Nothing playing"} :limit-width 28 :halign "center")
      (label :class "media-artist" :text {(media?.title ?: "") != "" ? (media?.artist ?: "") : "Start music or a video"} :limit-width 28 :halign "center")
      (box :class "preview-controls" :orientation "h" :space-evenly false :halign "center" :spacing 12 :active {(media?.player ?: "") != ""}
        (button :class "media-btn" :tooltip "Previous track" :onclick "~/.config/eww/scripts/media/control.sh previous" "󰒮")
        (button :class "media-btn play-btn" :tooltip "Play / pause" :onclick "~/.config/eww/scripts/media/control.sh play-pause" {media?.status == "Playing" ? "󰏤" : "󰐊"})
        (button :class "media-btn" :tooltip "Next track" :onclick "~/.config/eww/scripts/media/control.sh next" "󰒭")))))

; ============ Calendar Widget ============
(defwidget calendar-widget []
  (box :class "surface-card calendar-box" :orientation "h" :space-evenly false :spacing 16 :hexpand true
    (box :class "time-display-vertical" :orientation "v" :space-evenly false :valign "center" :halign "center"
      (label :class "time-hour" :text current_hour :halign "center")
      (label :class "time-separator" :text ":" :halign "center")
      (label :class "time-minute" :text current_minute :halign "center")
      (label :class "time-date" :text current_date :halign "center")
      (button :class "today-btn" :onclick "eww update cal-day=$(date +%d) cal-month=$(date +%m) cal-year=$(date +%Y)" :tooltip "Go to today" "󰃭 Today"))
    (box :hexpand true
      (calendar :class "calendar" :show-heading true :show-day-names true :hexpand true
                :day {cal-day > 0 ? cal-day : calendar_day} :month {cal-month > 0 ? cal-month : calendar_month_num} :year {cal-year > 0 ? cal-year : calendar_year}))))

; ============ Quick Controls Widget (placeholder) ============
(defwidget controls-widget []
  (box :class "widget controls-box" :orientation "v" :space-evenly false :spacing 8 :valign "center" :hexpand true
    (box :orientation "h" :space-evenly true :spacing 6
      (button :class "control-btn" :tooltip "Bluetooth" "󰂯")
      (button :class "control-btn" :tooltip "WiFi" "󰤨")
      (button :class "control-btn" :tooltip "Volume" "󰕾"))
    (box :orientation "h" :space-evenly true :spacing 6
      (button :class "control-btn" :tooltip "Brightness" "󰃟")
      (button :class "control-btn" :tooltip "DND" "󰂛")
      (button :class "control-btn" :tooltip "Settings" "󰒓"))))

; ============ Dashboard Tab Content ============
(defwidget syna-dashboard-content []
  (box :class "overview-tab" :orientation "v" :space-evenly false :spacing 16 :hexpand true
    (box :orientation "h" :space-evenly false
      (label :class "page-title" :text "Overview" :halign "start" :hexpand true)
      (label :class "page-subtitle" :text "${calendar_weekday} · ${current_date}" :halign "end"))
    (box :orientation "h" :space-evenly true :spacing 16 :hexpand true
      (profile-widget)
      (weather-widget))
    (box :orientation "h" :space-evenly true :spacing 16 :hexpand true
      (calendar-widget)
      (media-widget))))

; ============ Media Tab Content ============
(defwidget media-content []
  (box :class "media-tab" :orientation "v" :space-evenly false :spacing 16 :hexpand true :vexpand true
    (box :orientation "h" :space-evenly false
      (label :class "page-title" :text "Media" :halign "start" :hexpand true)
      (label :class "page-subtitle" :text {(media?.player ?: "") != "" ? (player-audio.player == media.player ? player-audio.label : media.player) : "No player connected"} :limit-width 35 :halign "end"))
    ; Main content: Album art left, controls right
    (box :class "media-main" :orientation "h" :space-evenly false :spacing 16
         :halign "fill" :valign "center" :vexpand true :hexpand true
      ; Album art (left, prominent)
      (box :class "surface-card artwork-card" :orientation "v" :space-evenly false :spacing 16
        (label :class "section-label" :text "ALBUM ART" :halign "start")
        (box :class "album-art-frame" :valign "center" :vexpand true
        (image :class "album-art-image"
               :path {media?.art != "" ? media?.art : "${EWW_CONFIG_DIR}/assets/no-album.png"}
               :image-width 220 :image-height 220))
        (label :class "playback-status" :text {media?.status == "Playing" ? "● PLAYING" : media?.status == "Paused" ? "Ⅱ PAUSED" : "○ READY"} :halign "center"))
      ; Controls stack (right of art)
      (box :class "surface-card media-detail" :orientation "v" :space-evenly false :spacing 10 :valign "fill" :hexpand true
        (label :class "section-label" :text "PLAYBACK" :halign "start")
        ; Player selector (if multiple)
        (box :class "player-selector" :orientation "h" :hexpand true
          (box :orientation "h" :halign "center" :hexpand true :spacing 6
            (for player in {media?.players ?: []}
              (button :class {(selected-player != "" ? selected-player : (media?.player ?: "")) == player ? "player-btn active" : "player-btn"}
                      :onclick `~/.config/eww/scripts/media/switch-player.sh '${player}'`
                      :tooltip player
                      (label :text {player == "spotify" ? "󰓇" :
                                    matches(player, "chromium.*") ? "󰖟" :
                                    matches(player, "firefox.*") ? "󰈹" :
                                    matches(player, "vlc.*") ? "󰕼" : "󰐌"})))))
        ; Track info
        (box :class "track-title-box" :hexpand true
          (label :class "track-title"
                 :text {(media?.title ?: "") != "" ? media.title : "Nothing playing"} :limit-width 40 :tooltip {media?.title ?: ""} :halign "center"))
        (label :class "track-artist" :text {(media?.title ?: "") != "" ? (media?.artist ?: "") : "Start music or a video to see it here"} :limit-width 40 :halign "center")
        ; EWW creates GTK adjustments with page-size 1: upper 101 gives usable 0–100.
        ; Apply the same compensation to progress and both volume scales.
        ; Progress bar (hide for live streams)
        (revealer :transition "slidedown" :reveal {(media?.duration ?: 0) > 0 && (media?.duration ?: 0) != (media?.position ?: 0)}
          (box :orientation "v" :space-evenly false :spacing 2
            (scale :class "progress-bar" :orientation "h"
                   :min 0 :max 101 :value {(media?.duration ?: 0) > 0 ? media.position * 100 / media.duration : 0}
                   :onchange "~/.config/eww/scripts/media/seek.sh {}")
            (box :orientation "h"
              (label :class "time-label" :text {media?.position_fmt ?: "0:00"} :halign "start" :hexpand true)
              (label :class "time-label" :text {media?.duration_fmt ?: "0:00"} :halign "end"))))
        (revealer :transition "slidedown" :reveal {((media?.duration ?: 0) == 0 || (media?.duration ?: 0) == (media?.position ?: 0)) && (media?.title ?: "") != "" && media?.status != "stopped"}
          (label :class "live-indicator" :text "∞ LIVE" :halign "center"))
        ; Playback controls
        (box :class "playback-controls" :active {(media?.player ?: "") != ""} :orientation "h" :hexpand true
          (box :orientation "h" :halign "center" :hexpand true :spacing 12
            (button :class "control-btn" :tooltip "Previous track" :onclick "~/.config/eww/scripts/media/control.sh previous" "󰒮")
            (button :class "control-btn play-btn" :tooltip "Play / pause" :onclick "~/.config/eww/scripts/media/control.sh play-pause"
                    {media?.status == "Playing" ? "󰏤" : "󰐊"})
            (button :class "control-btn" :tooltip "Next track" :onclick "~/.config/eww/scripts/media/control.sh next" "󰒭")))
        ; Player volume uses the same PulseAudio stream as deej.
        (box :class "volume-section" :orientation "h" :space-evenly false :spacing 12 :hexpand true
          (label :class "volume-kind" :text {player-audio.control_label} :tooltip {player-audio.tooltip})
          (scale :class "volume-slider" :orientation "h" :hexpand true :timeout "3s"
                 :active {player-audio.available} :min 0 :max 101 :round-digits 0 :value {player-audio.volume}
                 :onchange "python3 ~/.config/eww/scripts/media/audio-volume.py {}")
          (label :class "volume-label" :text {player-audio.available ? "${player-audio.volume}%" : "—"})
          (label :class "volume-label" :visible {player-audio.muted} :text "Muted"))
        ; Master volume uses the same sink as deej's master slider.
        (box :class "volume-section" :orientation "h" :space-evenly false :spacing 12 :hexpand true
          (label :class "volume-kind" :text "Master" :tooltip "System volume · deej slider 1")
          (box :orientation "h" :space-evenly false :spacing 6 :halign "center" :hexpand true
            (button :class "volume-btn" :tooltip "Mute / unmute system audio" :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
                    {media?.muted ? "󰖁" : (media?.volume ?: 0) > 66 ? "󰕾" : (media?.volume ?: 0) > 33 ? "󰖀" : "󰕿"})
            (scale :class "volume-slider" :hexpand true :tooltip "System volume" :orientation "h"
                   :min 0 :max 101 :round-digits 0 :value {media?.volume ?: 50}
                   :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
            (label :class "volume-label" :text "${media?.volume ?: 0}%")
            (box :style "min-width: 10px;")))
        ; Visualizer toggle
        (button :class "visualizer-toggle" :onclick "eww update show-visualizer=${show-visualizer ? 'false' : 'true'}"
                {show-visualizer ? "󰤽 Hide visualizer" : "󰋋 Show visualizer"})))
    ; Visualizer bar (bottom, full width)
    (revealer :transition "slideup" :reveal show-visualizer
      (box :class "media-visualizer-bar" :orientation "h" :hexpand true
        (label :class "visualizer-bars" :text cava :halign "center" :hexpand true)))))

;; ============ Performance Tab Redesign ============

;; Performance card with icon, gauge, value (eventbox enables hover)
(defwidget perf-card [icon value secondary percent label color delay-class]
  (eventbox :class "perf-card-hover"
    (box :class "perf-card ${delay-class}" :orientation "v" :space-evenly false :halign "center"
      (label :class "card-icon ${color}" :text icon :halign "center")
      (overlay
        (circular-progress
          :class "gauge-track"
          :value 100
          :start-at 75
          :thickness 7
          :clockwise true
          :width 110
          :height 110)
        (circular-progress
          :class "gauge-fill ${color}"
          :value percent
          :start-at 75
          :thickness 7
          :clockwise true
          :width 110
          :height 110)
        (box :class "gauge-center" :orientation "v" :valign "center" :halign "center" :space-evenly false
          (label :class "card-value" :text value :halign "center")
          (label :class "card-secondary" :text secondary :halign "center")))
      (label :class "card-label" :text label :halign "center"))))

;; System status indicator (uses temp_ok flags) - simple single label
(defwidget perf-status []
  (box :class "perf-status" :halign "center"
    (label
      :class {!(perf?.cpu?.temp_ok ?: false) && !(perf?.gpu?.temp_ok ?: false) ? "status-label unknown" :
              (perf?.cpu?.temp ?: 0) > 85 || (perf?.gpu?.temp ?: 0) > 85 ? "status-label critical" :
              (perf?.cpu?.temp ?: 0) > 70 || (perf?.gpu?.temp ?: 0) > 70 ? "status-label warning" :
              "status-label normal"}
      :text {!(perf?.cpu?.temp_ok ?: false) && !(perf?.gpu?.temp_ok ?: false) ? "● SYSTEM UNKNOWN" :
             (perf?.cpu?.temp ?: 0) > 85 || (perf?.gpu?.temp ?: 0) > 85 ? "● SYSTEM HOT" :
             (perf?.cpu?.temp ?: 0) > 70 || (perf?.gpu?.temp ?: 0) > 70 ? "● SYSTEM WARM" :
             "● SYSTEM NORMAL"})))

;; Footer - single centered row
(defwidget perf-footer []
  (box :class "perf-footer" :orientation "h" :halign "center" :hexpand true :spacing 32
    (label :class "footer-item connected" :text "●  Connected to ${sysinfo?.hostname ?: 'localhost'}")
    (label :class "footer-item" :text "○  Uptime: ${sysinfo?.uptime ?: '...'}")))

;; Performance tab - all rows share same width for consistent centering
(defwidget performance-content []
  (box :class "performance-tab" :orientation "v" :space-evenly false :vexpand true :hexpand true
    ;; Status row - fixed width wrapper
    (box :class "perf-row-wrapper" :width 900 :halign "center"
      (perf-status))
    ;; Cards row - fixed width wrapper
    (box :class "perf-row-wrapper" :width 900 :halign "center" :vexpand true :valign "center"
      (box :class "perf-cards" :orientation "h" :halign "center" :spacing 16
        ;; CPU
        (perf-card
          :icon "󰍛"
          :value {(perf?.cpu?.temp_ok ?: false) ? "${perf?.cpu?.temp}°C" : "--°C"}
          :secondary "${perf?.cpu?.percent ?: 0}% usage"
          :percent {perf?.cpu?.percent ?: 0}
          :label "CPU"
          :color "cpu"
          :delay-class "delay-0")
        ;; GPU
        (perf-card
          :icon "󰢮"
          :value {(perf?.gpu?.temp_ok ?: false) ? "${perf?.gpu?.temp}°C" : "--°C"}
          :secondary "${perf?.gpu?.percent ?: 0}% usage"
          :percent {perf?.gpu?.percent ?: 0}
          :label "GPU"
          :color "gpu"
          :delay-class "delay-1")
        ;; Memory
        (perf-card
          :icon "󰘚"
          :value "${perf?.ram?.used ?: '0'}GiB"
          :secondary "${perf?.ram?.percent ?: 0}% used"
          :percent {perf?.ram?.percent ?: 0}
          :label "MEMORY"
          :color "memory"
          :delay-class "delay-2")
        ;; Network
        (perf-card
          :icon "󰖩"
          :value "↓${perf?.net?.rx ?: '0'}"
          :secondary "↑${perf?.net?.tx ?: '0'} ${perf?.net?.tx_unit ?: 'KB/s'}"
          :percent {perf?.net?.activity ?: 0}
          :label "NETWORK"
          :color "network"
          :delay-class "delay-3")
        ;; Disk
        (perf-card
          :icon "󰋊"
          :value "${perf?.disk?.used ?: '0'}GB"
          :secondary "${perf?.disk?.percent ?: 0}% used"
          :percent {perf?.disk?.percent ?: 0}
          :label "DISK"
          :color "disk"
          :delay-class "delay-4")))
    ;; Footer row - fixed width wrapper
    (box :class "perf-row-wrapper" :width 900 :halign "center"
      (perf-footer))))

(defvar expanded-workspace 0)
(defpoll workspace-data :interval "2s"
  :run-while {active-tab == "workspaces"}
  :initial '{"groups":[],"summary":"Loading…","error":""}'
  `python3 ~/.config/eww/scripts/workspaces/workspaces.py`)

(defwidget workspace-card [ws]
  (box :class {ws.css} :orientation "v" :space-evenly false :spacing 8 :hexpand true :valign "start"
    (button :class "workspace-switch" :tooltip "Switch to workspace ${ws.id}"
            :onclick "hyprctl dispatch workspace ${ws.id}"
      (box :orientation "v" :space-evenly false :spacing 10
        (box :orientation "h" :space-evenly false
          (label :class "workspace-number" :text {ws.number} :hexpand true :halign "start")
          (label :class "workspace-state" :text {ws.state} :halign "end"))
        (label :class "workspace-apps" :text {ws.apps} :limit-width 24 :halign "start")
        (label :class "workspace-title" :text {ws.title} :limit-width 28 :halign "start")))
    (button :class "workspace-expand" :active {arraylength(ws.windows) > 0}
            :onclick "eww update expanded-workspace=${expanded-workspace == ws.id ? 0 : ws.id}"
      (box :orientation "h" :space-evenly false
        (label :text {ws.count} :halign "start" :hexpand true)
        (label :text {arraylength(ws.windows) == 0 ? "" : expanded-workspace == ws.id ? "▴" : "▾"})))
    (revealer :transition "slidedown" :duration "150ms" :reveal {expanded-workspace == ws.id}
      (box :orientation "v" :space-evenly false :spacing 4
        (for win in {ws.windows}
          (button :class "workspace-window" :tooltip {win.title}
                  :onclick "hyprctl dispatch focuswindow address:${win.address}"
            (box :orientation "v" :space-evenly false :spacing 3
              (label :class "workspace-window-app" :text {win.app} :limit-width 24 :halign "start")
              (label :text {win.title} :limit-width 26 :halign "start"))))))))

(defwidget workspaces-content []
  (box :class "workspaces-tab" :orientation "v" :space-evenly false :spacing 16 :hexpand true
    (box :orientation "h" :space-evenly false
      (label :class "page-title" :text "Workspaces" :halign "start" :hexpand true)
      (label :class "page-subtitle" :text {workspace-data.summary} :halign "end"))
    (label :visible {workspace-data.error != ""} :text {workspace-data.error} :class "page-subtitle")
    (scroll :height 430 :hscroll false :vscroll true
      (box :orientation "v" :space-evenly false :spacing 20
        (for monitor in {workspace-data.groups}
          (box :orientation "v" :space-evenly false :spacing 10
            (box :orientation "h" :space-evenly false
              (label :class "section-label" :text "${monitor.name} · ${monitor.port}" :halign "start" :hexpand true)
              (label :class "page-subtitle" :text {monitor.detail} :halign "end"))
            (box :orientation "v" :space-evenly false :spacing 12
              (for row in {monitor.rows}
                (box :orientation "h" :space-evenly true :spacing 16
                  (for ws in row
                    (workspace-card :ws ws)))))))))
    (label :class "page-subtitle" :text "Select a card to switch · Expand its window count to focus a window" :halign "center")))


; ============ Main Dashboard ============
(defwidget syna-dashboard []
  ; NOTE: Hover auto-close disabled for now - using keybind instead
  ; (eventbox :onhoverlost "eww close syna-dashboard" ...)
  (box :class "syna-dashboard" :orientation "v" :space-evenly false :spacing 0
    ; Hidden labels to keep deflisten variables alive (must be in mounted widget)
    (box :class "sr-only"
      (label :text cava)
      (label :text {media?.status ?: ""})
      (label :text {perf?.cpu?.percent ?: 0}))
    (tabs)
    (box :class "content" :orientation "v" :hexpand true
      (stack :same-size false :transition "none"
             :selected {active-tab == "dashboard" ? 0 : active-tab == "media" ? 1 : active-tab == "performance" ? 2 : 3}
        (syna-dashboard-content)
        (media-content)
        (performance-content)
        (workspaces-content)))))

; ============ Window Definition ============
(defwindow syna-dashboard
  :geometry (geometry :x "0%"
                      :y "0px"
                      :width "50%"
                      :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (syna-dashboard))

; ============ Hover Trigger Zone (DISABLED) ============
; NOTE: Hover zones disabled - using keybind to toggle syna-dashboard instead
; To re-enable: rename windows back to hover-zone-0/1 and uncomment eventbox above

(defwidget hover-trigger [monitor]
  (eventbox :onhover "eww update cal-day=$(date +%d) cal-month=$(date +%m) cal-year=$(date +%Y) && eww open syna-dashboard --screen ${monitor}"
    (box :class "hover-zone")))

(defwindow _disabled_hover-zone-0
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0px"
                      :width "30%"
                      :height "4px"
                      :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (hover-trigger :monitor 0))

(defwindow _disabled_hover-zone-1
  :monitor 1
  :geometry (geometry :x "0%"
                      :y "0px"
                      :width "30%"
                      :height "4px"
                      :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (hover-trigger :monitor 1))
